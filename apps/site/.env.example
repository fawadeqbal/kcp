# Copy to .env.local to change where the site links to. These are read at build time.

# The API (waitlist sign-up and confirmation, prices per country).
NEXT_PUBLIC_API_URL=http://localhost:3000

# The student and parent web app ("Sign up as a parent", privacy policy and terms).
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3001

# This site's own public address, for canonical links, hreflang, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3003
