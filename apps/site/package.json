{
  "name": "@kcp/site",
  "version": "0.0.0",
  "private": true,
  "description": "Public marketing website (Next.js, static): home, how it works, tracks, safety, about, FAQ, pricing per country, blog (MDX) and the waitlist, in English, Arabic and Urdu.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "node scripts/build.mjs",
    "start": "next start --port 3003",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src e2e",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@kcp/i18n": "workspace:*",
    "@kcp/ui": "workspace:*",
    "clsx": "^2.1.1",
    "next": "16.3.7",
    "next-intl": "^4.14.8",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.2"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/.next"
        ]
      },
      "test:browser": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  }
}
