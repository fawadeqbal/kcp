# Web app origins allowed to embed the sandbox (space-separated).
SANDBOX_FRAME_ANCESTORS=http://localhost:3001
SANDBOX_PORT=3004

# Read when the sandbox is BUILT (pnpm build), for the public portfolio page
# (/portfolio/#<link>): the API it reads shared portfolios from, and the web app it
# links back to.
SANDBOX_API_URL=http://localhost:3000
SANDBOX_WEB_URL=http://localhost:3001
