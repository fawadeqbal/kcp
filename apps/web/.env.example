# Copy to .env.local if the API is not on http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# The sandbox that runs students' code (apps/sandbox). Use its own domain in production.
NEXT_PUBLIC_SANDBOX_URL=http://localhost:3004

# Where families write to pay by bank transfer or mobile wallet (shown on the billing page).
NEXT_PUBLIC_BILLING_EMAIL=billing@kidscoding.example
