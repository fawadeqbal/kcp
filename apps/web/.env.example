# Copy to .env.local if the API is not on http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# The sandbox that runs students' code (apps/sandbox). Use its own domain in production.
NEXT_PUBLIC_SANDBOX_URL=http://localhost:3004

# Where families write to pay by bank transfer or mobile wallet (shown on the billing page).
NEXT_PUBLIC_BILLING_EMAIL=billing@kidscoding.example

# The mobile app's links (/.well-known/assetlinks.json and apple-app-site-association):
# lesson and dashboard links then open the app when it's installed. Leave empty until
# the app is in the stores. Fingerprints: Play Console → Test and release → App
# integrity → App signing (SHA-256), comma-separated.
# APP_ANDROID_PACKAGE=org.kidscoding.app
# APP_ANDROID_SHA256=
# APP_IOS_APP_ID=TEAMID1234.org.kidscoding.app
