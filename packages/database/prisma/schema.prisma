// Kids Coding Platform — database schema
//
// Accounts and families, consent, roles and permissions, sessions, locations,
// languages, learning content and progress, audit log and feature flags. Later
// sprints add game, portfolio and money models (see implementation-plan.md).
//
// Conventions
// - Models are PascalCase; tables and columns are snake_case (@@map / @map).
// - IDs are UUID v7 (time-ordered) unless a natural key exists (country code, language code).
// - Append-only tables (audit_logs, consent_records) are never updated in place;
//   audit_logs is protected by a database trigger (see the init migration).

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Accounts
// ─────────────────────────────────────────────────────────────

/// STUDENT accounts sign in with a username set by their parent.
/// ADULT accounts (parents, mentors, staff, teachers, clients) sign in with email.
enum AccountKind {
  STUDENT
  ADULT
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
  /// A child under 13 whose parent hasn't finished verified parental consent yet:
  /// the account exists but can't be used.
  PENDING_CONSENT
}

model User {
  id                   String      @id @default(uuid(7)) @db.Uuid
  kind                 AccountKind
  status               UserStatus  @default(PENDING_VERIFICATION)
  /// Every account has exactly one role (scope: "Roles and permissions").
  roleId               String      @map("role_id") @db.Uuid
  /// Adults only. Stored lowercase.
  email                String?     @unique
  emailVerifiedAt      DateTime?   @map("email_verified_at")
  /// Students only. Generated and non-identifying, e.g. "blue-falcon-42".
  username             String?     @unique
  passwordHash         String?     @map("password_hash")
  /// Adults only. Never shown publicly.
  displayName          String?     @map("display_name")
  languageCode         String      @default("en") @map("language_code")
  countryCode          String?     @map("country_code") @db.Char(2)
  regionId             String?     @map("region_id") @db.Uuid
  cityId               String?     @map("city_id") @db.Uuid
  /// Encrypted TOTP secret; required for staff roles.
  totpSecret           String?     @map("totp_secret")
  totpEnabledAt        DateTime?   @map("totp_enabled_at")
  lastLoginAt          DateTime?   @map("last_login_at")
  /// Version of the terms and privacy policy the adult accepted at sign-up.
  termsVersion         String?     @map("terms_version")
  termsAcceptedAt      DateTime?   @map("terms_accepted_at")
  /// Parents: the monthly email about their children's progress (they can switch it off).
  monthlySummaryEmails Boolean     @default(true) @map("monthly_summary_emails")
  /// Parents: the weekly report on Sunday evenings (they can switch it off).
  weeklyReportEmails   Boolean     @default(true) @map("weekly_report_emails")
  /// Parents: the code in their invite link (made when first asked for).
  referralCode         String?     @unique @map("referral_code")
  /// Parents: free trials started for their children, ever (deleted children count
  /// too), so deleting and re-adding a child can't restart the trial again and again.
  trialsStarted        Int         @default(0) @map("trials_started") @db.SmallInt
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")

  role     Role     @relation(fields: [roleId], references: [id])
  language Language @relation(fields: [languageCode], references: [code])
  country  Country? @relation(fields: [countryCode], references: [code])
  region   Region?  @relation(fields: [regionId], references: [id])
  city     City?    @relation(fields: [cityId], references: [id])

  studentProfile     StudentProfile?
  childLinks         ParentChildLink[]        @relation("ParentLinks")
  parentLinks        ParentChildLink[]        @relation("ChildLinks")
  consentsGiven      ConsentRecord[]          @relation("ConsentParent")
  consentsReceived   ConsentRecord[]          @relation("ConsentChild")
  sessions           Session[]
  verificationTokens VerificationToken[]
  lessonProgress     LessonProgress[]
  challengeDrafts    ChallengeDraft[]
  submissions        Submission[]
  projects           Project[]
  portfolioItems     PortfolioItem[]
  xpEvents           XpEvent[]
  streak             Streak?
  feedback           Feedback[]
  premiumGrants      PremiumGrant[]           @relation("PremiumGrantStudent")
  badges             UserBadge[]
  leaderboardResults LeaderboardResult[]
  premiumGranted     PremiumGrant[]           @relation("PremiumGrantStaff")
  premiumRevoked     PremiumGrant[]           @relation("PremiumGrantRevoker")
  billingCustomers   BillingCustomer[]
  subscriptions      Subscription[]
  payments           Payment[]                @relation("PaymentParent")
  paymentsRecorded   Payment[]                @relation("PaymentRecorder")
  invoices           Invoice[]
  refundsMade        Refund[]
  notifications      Notification[]
  certificates       Certificate[]
  quizAttempts       QuizAttempt[]
  practiceSessions   PracticeSession[]
  deviceTokens       DeviceToken[]
  contentDrafts      ContentDraft[]
  mentorProfile      MentorProfile?
  reviewsReceived    Review[]                 @relation("ReviewStudent")
  reviewsGiven       Review[]                 @relation("ReviewMentor")
  reviewComments     ReviewComment[]
  mentorNotesAbout   MentorNote[]             @relation("MentorNoteStudent")
  mentorNotesWritten MentorNote[]             @relation("MentorNoteAuthor")
  consentRequests    ParentalConsentRequest[] @relation("ParentalConsentParent")
  consentChecks      ParentalConsentRequest[] @relation("ParentalConsentChild")
  consentDecisions   ParentalConsentRequest[] @relation("ParentalConsentStaff")
  pairingsApproved   DevicePairing[]          @relation("PairingParent")
  pairingsReceived   DevicePairing[]          @relation("PairingChild")
  leagueMemberships  LeagueMembership[]
  friendRequestsSent FriendRequest[]          @relation("FriendRequestFrom")
  friendRequestsGot  FriendRequest[]          @relation("FriendRequestTo")
  friendshipsA       Friendship[]             @relation("FriendshipA")
  friendshipsB       Friendship[]             @relation("FriendshipB")
  referralsMade      Referral[]               @relation("ReferralReferrer")
  referredBy         Referral?                @relation("ReferralInvitee")
  activityDays       StudentActivityDay[]
  parentReports      ParentReport[]
  chatMemberships    ChatMember[]
  gitAccount         GitAccount?
  eventTeams         EventTeamMember[]        @relation("EventTeamMemberUser")
  eventApprovals     EventTeamMember[]        @relation("EventTeamMemberApprover")
  mentoredTeams      EventTeam[]              @relation("EventTeamMentor")
  eventJudging       EventJudge[]
  eventScores        EventScore[]
  eventSubmissions   EventSubmission[]
  eventsCreated      Event[]
  chatMessages       ChatMessage[]            @relation("ChatMessageAuthor")
  chatReportsMade    ChatReport[]             @relation("ChatReportReporter")
  chatReportsAbout   ChatReport[]             @relation("ChatReportSubject")
  moderationActions  ModerationAction[]       @relation("ModerationSubject")
  moderationTaken    ModerationAction[]       @relation("ModerationStaff")
  schoolsTeaching    SchoolTeacher[]
  classesTaught      SchoolClass[]            @relation("ClassTeacher")
  classMemberships   ClassMember[]            @relation("ClassMemberUser")
  classApprovals     ClassMember[]            @relation("ClassMemberApprover")
  assignmentsMade    Assignment[]
  licensesRecorded   SchoolLicense[]
  readinessChecks    ReadinessCheck[]
  hubEligibility     HubEligibility?          @relation("HubEligibilityStudent")
  hubSignOffs        HubEligibility[]         @relation("HubEligibilitySignOff")
  hubRevocations     HubEligibility[]         @relation("HubEligibilityRevoker")
  clientMembership   ClientMember?
  clientAgreements   ClientOrg[]              @relation("ClientOrgSigner")
  hubIntakesMade     HubIntake[]              @relation("HubIntakeAuthor")
  hubIntakesDecided  HubIntake[]              @relation("HubIntakeDecider")
  hubProjectsLed     HubProject[]             @relation("HubProjectLead")
  hubProjectsMade    HubProject[]             @relation("HubProjectCreator")
  hubQuotesMade      HubQuote[]               @relation("HubQuoteCreator")
  hubQuotesApproved  HubQuote[]               @relation("HubQuoteApprover")
  hubTasks           HubTask[]                @relation("HubTaskAssignee")
  hubPaymentsMade    HubPayment[]             @relation("HubPaymentRecorder")
  hubMemberships     HubMember[]              @relation("HubMemberStudent")
  hubInvitesSent     HubMember[]              @relation("HubMemberInviter")
  hubApprovals       HubMember[]              @relation("HubMemberParent")
  hubTimeEntries     HubTimeEntry[]
  hubReviewsGot      HubCodeReview[]          @relation("HubCodeReviewStudent")
  hubReviewsGiven    HubCodeReview[]          @relation("HubCodeReviewReviewer")
  hubDeliveriesMade  HubDelivery[]            @relation("HubDeliveryCreator")
  hubDeliveriesSeen  HubDelivery[]            @relation("HubDeliveryDecider")
  hubComments        HubComment[]
  hubChangesAsked    HubChangeRequest[]       @relation("HubChangeAuthor")
  hubChangesDecided  HubChangeRequest[]       @relation("HubChangeDecider")
  hubEarnings        HubEarning[]
  payoutAccounts     PayoutAccount[]          @relation("PayoutAccountParent")
  payoutAccountsSeen PayoutAccount[]          @relation("PayoutAccountVerifier")
  payoutBatchesMade  PayoutBatch[]            @relation("PayoutBatchCreator")
  payoutBatchesOk1   PayoutBatch[]            @relation("PayoutBatchFirstApprover")
  payoutBatchesOk2   PayoutBatch[]            @relation("PayoutBatchSecondApprover")
  payoutsEarned      Payout[]                 @relation("PayoutStudent")
  payoutsReceived    Payout[]                 @relation("PayoutParent")
  payoutsRecorded    Payout[]                 @relation("PayoutRecorder")
  hubStoriesAbout    HubStory[]               @relation("HubStoryStudent")
  hubStoriesAsked    HubStory[]               @relation("HubStoryParent")
  hubStoriesWritten  HubStory[]               @relation("HubStoryAuthor")

  @@index([roleId])
  @@index([countryCode, regionId, cityId])
  @@map("users")
}

/// Public identity of a student: nickname and preset avatar only.
/// Never store a real name, photo, school name or exact location here.
model StudentProfile {
  userId              String    @id @map("user_id") @db.Uuid
  nickname            String
  avatarKey           String    @map("avatar_key")
  birthYear           Int       @map("birth_year") @db.SmallInt
  /// Mirrors the latest PUBLIC_LEADERBOARDS consent, for fast leaderboard writes.
  showOnPublicBoards  Boolean   @default(false) @map("show_on_public_boards")
  /// Mirrors the latest PUBLIC_PORTFOLIO consent.
  publicPortfolio     Boolean   @default(false) @map("public_portfolio")
  /// Set only after mentor check + parent approval (Phase 3).
  isHubEligible       Boolean   @default(false) @map("is_hub_eligible")
  /// Sum of the student's XP events, kept up to date in the same transaction (a cache:
  /// xp_events is the source of truth).
  xpTotal             Int       @default(0) @map("xp_total")
  /// The unlisted link to the portfolio, made by the parent. Works only while
  /// publicPortfolio is on; a new link replaces the old one.
  portfolioShareToken String?   @unique @map("portfolio_share_token")
  /// Every new student gets premium to try until this moment (TRIAL_DAYS).
  trialEndsAt         DateTime? @map("trial_ends_at")
  /// When the parent was told the trial ends soon (once per trial).
  trialReminderSentAt DateTime? @map("trial_reminder_sent_at")
  /// Evening reminders on the child's phone when today's goal isn't met yet; the
  /// parent can switch them off.
  streakReminders     Boolean   @default(true) @map("streak_reminders")
  /// Picture password (younger children): argon2 hash of four pictures in order, set by
  /// the parent. Five wrong tries lock it for an hour (the text password still works).
  picturePasswordHash String?   @map("picture_password_hash")
  pictureFailures     Int       @default(0) @map("picture_failures") @db.SmallInt
  pictureLockedUntil  DateTime? @map("picture_locked_until")
  /// The student's league (0 = Bronze … 6 = Diamond; LEAGUE_TIERS). Changes when a
  /// league week closes: top of the group moves up, bottom moves down.
  leagueTier          Int       @default(0) @map("league_tier") @db.SmallInt
  /// Given to friends to send a friend request (made when first asked for).
  friendCode          String?   @unique @map("friend_code")
  /// Staff muted the student in every room until then (a moderation action).
  chatMutedUntil      DateTime? @map("chat_muted_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

enum GuardianRelationship {
  PARENT
  GUARDIAN
}

model ParentChildLink {
  id           String               @id @default(uuid(7)) @db.Uuid
  parentId     String               @map("parent_id") @db.Uuid
  childId      String               @map("child_id") @db.Uuid
  relationship GuardianRelationship @default(PARENT)
  isPrimary    Boolean              @default(true) @map("is_primary")
  createdAt    DateTime             @default(now()) @map("created_at")

  parent User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([childId])
  @@map("parent_child_links")
}

enum ConsentType {
  ACCOUNT
  PUBLIC_LEADERBOARDS
  PUBLIC_PORTFOLIO
  HUB_WORK
  EARNINGS
}

/// How consent was verified. The lawyer decides which methods are enough per
/// country; storing the method lets us upgrade it later without losing history.
enum ConsentMethod {
  EMAIL_CONFIRMATION
  PAYMENT_CARD
  ID_DOCUMENT
  SIGNED_FORM
  OTHER
  /// "Email plus": the parent confirms from an email, and a second email follows later.
  EMAIL_PLUS
}

/// Verified parental consent for children under 13: the methods a country accepts
/// (the lawyer decides per country; Admin → Countries sets them).
enum Under13ConsentMethod {
  /// The parent confirms a payment card (Stripe checks it; nothing is charged).
  CARD_CHECK
  /// The parent signs a form and uploads it; staff check it.
  SIGNED_FORM
  /// The parent confirms from an email; a second email follows a day later.
  EMAIL_PLUS
}

enum ParentalConsentStatus {
  /// Waiting for the parent (to pick a method, pay the card check, or click the email).
  PENDING
  /// Signed form uploaded, waiting for staff.
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
}

/// One attempt at verified parental consent for a child under 13. The child stays
/// PENDING_CONSENT until one is VERIFIED; the ConsentRecord rows are written then.
model ParentalConsentRequest {
  id               String                @id @default(uuid(7)) @db.Uuid
  parentId         String                @map("parent_id") @db.Uuid
  childId          String                @map("child_id") @db.Uuid
  method           Under13ConsentMethod?
  status           ParentalConsentStatus @default(PENDING)
  policyVersion    String                @map("policy_version")
  /// CARD_CHECK: the Stripe Checkout session (setup mode).
  providerRef      String?               @unique @map("provider_ref")
  /// SIGNED_FORM: where the upload is kept (deleted 30 days after the decision).
  formKey          String?               @map("form_key")
  formContentType  String?               @map("form_content_type")
  formDeletedAt    DateTime?             @map("form_deleted_at")
  /// EMAIL_PLUS: when the parent confirmed from the email, and when the follow-up went.
  emailConfirmedAt DateTime?             @map("email_confirmed_at")
  followUpSentAt   DateTime?             @map("follow_up_sent_at")
  submittedAt      DateTime?             @map("submitted_at")
  decidedAt        DateTime?             @map("decided_at")
  /// Staff who checked a signed form.
  decidedById      String?               @map("decided_by_id") @db.Uuid
  rejectReason     String?               @map("reject_reason")
  ipAddress        String?               @map("ip_address")
  userAgent        String?               @map("user_agent")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  parent    User  @relation("ParentalConsentParent", fields: [parentId], references: [id], onDelete: Cascade)
  child     User  @relation("ParentalConsentChild", fields: [childId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("ParentalConsentStaff", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([childId, createdAt])
  @@index([status, submittedAt])
  @@index([parentId])
  @@map("parental_consent_requests")
}

/// Append-only: a new grant is a new row; revoking sets revoked_at.
model ConsentRecord {
  id            String        @id @default(uuid(7)) @db.Uuid
  parentId      String        @map("parent_id") @db.Uuid
  childId       String        @map("child_id") @db.Uuid
  type          ConsentType
  policyVersion String        @map("policy_version")
  method        ConsentMethod
  grantedAt     DateTime      @default(now()) @map("granted_at")
  revokedAt     DateTime?     @map("revoked_at")
  ipAddress     String?       @map("ip_address")
  userAgent     String?       @map("user_agent")

  parent User @relation("ConsentParent", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ConsentChild", fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, type])
  @@index([parentId])
  @@index([grantedAt])
  @@map("consent_records")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// SHA-256 of the refresh token; the raw token is never stored.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// Set when this session's token was rotated into a new one.
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  /// When the user last typed their password (and code): kept through refresh-token
  /// rotation, so a session can't be extended forever (an absolute lifetime).
  authenticatedAt  DateTime  @default(now()) @map("authenticated_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Phones registered for push notifications while signed in with this session.
  deviceTokens DeviceToken[]

  @@index([userId])
  @@map("sessions")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// "Email plus" parental consent: the link in the email (the token names the request).
  PARENTAL_CONSENT
}

/// One-time links sent by email. Only a SHA-256 hash of the token is stored.
model VerificationToken {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  tokenHash String              @unique @map("token_hash")
  expiresAt DateTime            @map("expires_at")
  usedAt    DateTime?           @map("used_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

/// "Sign in with a parent's phone": a child's device shows a short code (and a QR
/// code); a parent approves it for one of their children; the device that showed it
/// then gets the child's session. Only hashes of the code and the device's secret
/// are stored. Codes last 10 minutes and work once.
model DevicePairing {
  id           String    @id @default(uuid(7)) @db.Uuid
  codeHash     String    @unique @map("code_hash")
  secretHash   String    @map("secret_hash")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  childId      String?   @map("child_id") @db.Uuid
  approvedById String?   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime? @map("approved_at")
  claimedAt    DateTime? @map("claimed_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  child      User? @relation("PairingChild", fields: [childId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("PairingParent", fields: [approvedById], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("device_pairings")
}

// ─────────────────────────────────────────────────────────────
// Roles and permissions (enforced by NestJS guards + CASL)
// ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Stable key used in code, e.g. "student", "parent", "super_admin".
  key         String   @unique
  name        String
  description String?
  /// Staff roles must use two-factor login and the admin panel.
  isStaff     Boolean  @default(false) @map("is_staff")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  /// CASL action: "manage", "create", "read", "update", "delete", or a custom verb.
  action      String
  /// CASL subject: a model name such as "User", or "all".
  subject     String
  description String?

  roles RolePermission[]

  @@unique([action, subject])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  /// Optional CASL conditions with placeholders, e.g. { "id": "${user.id}" }.
  conditions   Json?
  /// Limits the rule to these fields (empty = all fields).
  fields       String[] @default([])
  /// true = "cannot" rule (an explicit deny).
  inverted     Boolean  @default(false)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────
// Location (country → region → city) — also used by leaderboards
// ─────────────────────────────────────────────────────────────

model Country {
  /// ISO 3166-1 alpha-2, e.g. "PK".
  code                  String                 @id @db.Char(2)
  /// Names per language code, e.g. { "en": "Pakistan", "ar": "باكستان", "ur": "پاکستان" }.
  names                 Json
  /// ISO 4217, e.g. "PKR".
  currency              String                 @db.Char(3)
  timezone              String
  defaultLanguageCode   String                 @map("default_language_code")
  /// Countries are switched on one by one from the admin panel.
  isActive              Boolean                @default(false) @map("is_active")
  /// Each child after the first costs this much less (the family discount).
  familyDiscountPercent Int                    @default(30) @map("family_discount_percent") @db.SmallInt
  /// How parents of children under 13 can give verified consent here. None: no
  /// under-13 accounts in this country (even with the under_13_accounts flag on).
  under13ConsentMethods Under13ConsentMethod[] @default([]) @map("under13_consent_methods")
  /// The hub (paid client work for students) is open here — only after the lawyer's
  /// review of child work, earnings, tax and IP for this country.
  hubEnabled            Boolean                @default(false) @map("hub_enabled")
  /// Youngest age for paid hub work.
  hubMinAge             Int                    @default(15) @map("hub_min_age") @db.SmallInt
  /// Most hub work a student may do in a week (their own Monday to Sunday), in minutes.
  hubWeeklyMinutes      Int                    @default(360) @map("hub_weekly_minutes") @db.SmallInt
  /// Hub work only between these local times (minutes after midnight): 07:00–21:00.
  hubDayStartMinute     Int                    @default(420) @map("hub_day_start_minute") @db.SmallInt
  hubDayEndMinute       Int                    @default(1260) @map("hub_day_end_minute") @db.SmallInt
  /// No hub work during school hours on school days (0 = Sunday … 6 = Saturday).
  hubSchoolDays         Int[]                  @default([1, 2, 3, 4, 5]) @map("hub_school_days")
  hubSchoolStartMinute  Int                    @default(480) @map("hub_school_start_minute") @db.SmallInt
  hubSchoolEndMinute    Int                    @default(840) @map("hub_school_end_minute") @db.SmallInt
  /// How a project's money is split by default (percent, adding up to 100).
  hubStudentPercent     Int                    @default(50) @map("hub_student_percent") @db.SmallInt
  hubLeadPercent        Int                    @default(25) @map("hub_lead_percent") @db.SmallInt
  hubPlatformPercent    Int                    @default(25) @map("hub_platform_percent") @db.SmallInt
  /// Students' earnings are held this many days before they can be paid out.
  hubHoldDays           Int                    @default(14) @map("hub_hold_days") @db.SmallInt
  /// Withheld from payouts where the law asks for it, in basis points (100 = 1%).
  hubWithholdingBp      Int                    @default(0) @map("hub_withholding_bp") @db.SmallInt
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  defaultLanguage Language    @relation(fields: [defaultLanguageCode], references: [code])
  regions         Region[]
  users           User[]
  prices          PlanPrice[]
  schools         School[]
  clientOrgs      ClientOrg[]

  @@map("countries")
}

model Region {
  id          String   @id @default(uuid(7)) @db.Uuid
  countryCode String   @map("country_code") @db.Char(2)
  slug        String
  names       Json
  /// Overrides the country's timezone when set.
  timezone    String?
  createdAt   DateTime @default(now()) @map("created_at")

  country Country @relation(fields: [countryCode], references: [code])
  cities  City[]
  users   User[]

  @@unique([countryCode, slug])
  @@map("regions")
}

model City {
  id        String   @id @default(uuid(7)) @db.Uuid
  regionId  String   @map("region_id") @db.Uuid
  slug      String
  names     Json
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at")

  region Region @relation(fields: [regionId], references: [id])
  users  User[]

  @@unique([regionId, slug])
  @@map("cities")
}

// ─────────────────────────────────────────────────────────────
// Languages
// ─────────────────────────────────────────────────────────────

enum TextDirection {
  LTR
  RTL
}

model Language {
  /// BCP 47 code, e.g. "en", "ar", "ur".
  code       String        @id
  name       String
  nativeName String        @map("native_name")
  direction  TextDirection @default(LTR)
  isActive   Boolean       @default(false) @map("is_active")
  sortOrder  Int           @default(0) @map("sort_order")

  users                 User[]
  countries             Country[]
  lessonTranslations    LessonTranslation[]
  challengeTranslations ChallengeTranslation[]
  briefTranslations     ProjectBriefTranslation[]
  contentDrafts         ContentDraft[]

  @@map("languages")
}

// ─────────────────────────────────────────────────────────────
// Learning
//
// Content (tracks, modules, lessons, challenges and their translations) is written
// as files in content/ and written here by tools/content-import. Its IDs are the
// content keys (e.g. "builder-m01-l03"), so progress survives every re-import.
// Content is never deleted, only switched off (isActive = false).
// ─────────────────────────────────────────────────────────────

enum ChallengeType {
  HTML
  CSS
  JS
  /// Runs with Pyodide in a Web Worker on the sandbox origin (Sprint 5).
  PYTHON
  /// Explorer: a block program on a stage (packages/checks/src/stage). Programs are
  /// data, so the API checks them itself; no student code runs.
  BLOCKS
  /// Pro: git commands in a practice repository (packages/checks/src/git). The steps
  /// are data, so the API replays them itself; no real git runs.
  GIT
}

enum LessonStatus {
  STARTED
  COMPLETED
}

/// A learning path, e.g. "builder".
model Track {
  id        String   @id
  /// Title per language code, e.g. { "en": "Builder", "ar": "…" }.
  titles    Json
  sortOrder Int      @default(0) @map("sort_order")
  /// Ages the track is made for (e.g. Explorer 9–12): students of those ages see it first.
  ageFrom   Int?     @map("age_from")
  ageTo     Int?     @map("age_to")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  modules Module[]
  classes SchoolClass[]

  @@map("tracks")
}

model Module {
  id           String    @id
  trackId      String    @map("track_id")
  /// Folder name, e.g. "m01-first-website".
  slug         String
  titles       Json
  descriptions Json
  sortOrder    Int       @default(0) @map("sort_order")
  /// In content/ (the importer switches off what was removed from the files).
  isActive     Boolean   @default(true) @map("is_active")
  /// Students see a module once staff publish it (Admin → Content). Imports in
  /// staging and production leave new modules unpublished; development publishes them.
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  track          Track           @relation(fields: [trackId], references: [id])
  lessons        Lesson[]
  projectBrief   ProjectBrief?
  portfolioItems PortfolioItem[]

  @@index([trackId, sortOrder])
  @@map("modules")
}

model Lesson {
  id        String   @id
  moduleId  String   @map("module_id")
  slug      String
  sortOrder Int      @default(0) @map("sort_order")
  xp        Int      @default(0)
  /// Stored from Sprint 3; enforced when plans arrive (Sprint 6).
  isPremium Boolean  @default(false) @map("is_premium")
  /// What the lesson teaches (Skill keys, from content/skills.yaml): the skill map.
  skills    String[] @default([])
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  module       Module              @relation(fields: [moduleId], references: [id])
  translations LessonTranslation[]
  challenges   Challenge[]
  quizzes      Quiz[]
  progress     LessonProgress[]
  assignments  Assignment[]

  @@index([moduleId, sortOrder])
  @@map("lessons")
}

model LessonTranslation {
  lessonId      String        @map("lesson_id")
  languageCode  String        @map("language_code")
  title         String
  summary       String
  /// The explainer, in Markdown.
  body          String
  /// Optional video in this language, e.g. provider "youtube" and its video ID.
  videoProvider String?       @map("video_provider")
  videoId       String?       @map("video_id")
  /// Where the live text came from: the content/ files or the content studio.
  source        ContentSource @default(IMPORT)
  /// Hash of the file text last imported, so an import only overwrites studio work
  /// when the file itself changed.
  importHash    String?       @map("import_hash")

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageCode], references: [code])

  @@id([lessonId, languageCode])
  @@map("lesson_translations")
}

/// A "try it" step: starter code, and checks that run in the browser sandbox.
model Challenge {
  id        String        @id
  lessonId  String        @map("lesson_id")
  sortOrder Int           @default(0) @map("sort_order")
  type      ChallengeType
  xp        Int           @default(0)
  /// Starting code per file: { "html": "…", "css": "…", "js": "…" }.
  starter   Json
  /// Declarative checks and JavaScript tests (types in packages/checks).
  checks    Json
  /// BLOCKS: the level (map, toolbox), see StageLevel in packages/checks.
  stage     Json?
  /// GIT: the practice repository it starts with (files, setup), see GitSetup.
  repo      Json?
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  lesson       Lesson                 @relation(fields: [lessonId], references: [id])
  translations ChallengeTranslation[]
  drafts       ChallengeDraft[]
  submissions  Submission[]

  @@index([lessonId, sortOrder])
  @@map("challenges")
}

model ChallengeTranslation {
  challengeId  String        @map("challenge_id")
  languageCode String        @map("language_code")
  title        String
  /// What to do, in Markdown.
  instructions String
  /// Hint texts by key, e.g. { "add_link": "Use the <a> tag…" }.
  hints        Json
  /// What each check looks at, by check ID, e.g. { "has-link": "The page has a link" }.
  checkLabels  Json          @default("{}") @map("check_labels")
  source       ContentSource @default(IMPORT)
  importHash   String?       @map("import_hash")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  language  Language  @relation(fields: [languageCode], references: [code])

  @@id([challengeId, languageCode])
  @@map("challenge_translations")
}

model LessonProgress {
  userId      String       @map("user_id") @db.Uuid
  lessonId    String       @map("lesson_id")
  status      LessonStatus @default(STARTED)
  startedAt   DateTime     @default(now()) @map("started_at")
  completedAt DateTime?    @map("completed_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

/// The student's latest code for a challenge, saved while they type.
model ChallengeDraft {
  userId      String   @map("user_id") @db.Uuid
  challengeId String   @map("challenge_id")
  /// { "html": "…", "css": "…", "js": "…" }
  code        Json
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@id([userId, challengeId])
  @@index([challengeId])
  @@map("challenge_drafts")
}

/// One "Check my code": the code and what the checks in the browser sandbox found.
model Submission {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  challengeId String   @map("challenge_id")
  code        Json
  passed      Boolean
  /// Per check: { id, passed } — see packages/checks.
  results     Json
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@index([userId, challengeId, createdAt])
  @@index([challengeId])
  @@map("submissions")
}

// ─────────────────────────────────────────────────────────────
// System
// ─────────────────────────────────────────────────────────────

/// Who changed what and when. Append-only: UPDATE and DELETE are blocked by a trigger.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // No foreign key on actor_id on purpose: the audit trail must outlive the accounts it mentions.

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model FeatureFlag {
  key          String   @id
  description  String?
  enabled      Boolean  @default(false)
  /// Empty = applies to every country.
  countryCodes String[] @default([]) @map("country_codes")
  updatedById  String?  @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ── Projects and portfolio ───────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  SHIPPED
}

/// The project that ends a module (content/…/project.yaml), imported like lessons.
model ProjectBrief {
  /// Content key, e.g. "builder-m01-project".
  id        String   @id
  moduleId  String   @unique @map("module_id")
  xp        Int      @default(100)
  /// Starting files: { "html": "…", "css": "…", "js": "…" }.
  starter   Json
  /// What the project needs before it can be shipped (see packages/checks).
  checks    Json
  /// Block projects (Explorer): the level, see StageLevel in packages/checks.
  stage     Json?
  /// Premium projects need a trial, a subscription or premium given by hand.
  isPremium Boolean  @default(false) @map("is_premium")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  module       Module                    @relation(fields: [moduleId], references: [id])
  translations ProjectBriefTranslation[]
  projects     Project[]

  @@map("project_briefs")
}

model ProjectBriefTranslation {
  briefId      String        @map("brief_id")
  languageCode String        @map("language_code")
  title        String
  summary      String
  /// The brief, in Markdown.
  body         String
  /// Hint texts by key.
  hints        Json          @default("{}")
  /// What each check looks at, by check ID.
  checkLabels  Json          @default("{}") @map("check_labels")
  source       ContentSource @default(IMPORT)
  importHash   String?       @map("import_hash")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  brief    ProjectBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  language Language     @relation(fields: [languageCode], references: [code])

  @@id([briefId, languageCode])
  @@map("project_brief_translations")
}

/// A student's project for one brief: the draft they work on, and whether it shipped.
model Project {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  briefId   String        @map("brief_id")
  /// The current draft: { "html": "…", "css": "…", "js": "…" }.
  files     Json
  status    ProjectStatus @default(DRAFT)
  shippedAt DateTime?     @map("shipped_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brief         ProjectBrief   @relation(fields: [briefId], references: [id])
  portfolioItem PortfolioItem?
  reviews       Review[]

  @@unique([userId, briefId])
  @@index([briefId])
  @@map("projects")
}

/// A shipped project on the student's portfolio. Its files are in file storage
/// (R2), one folder per version; shipping again adds a version. Who can see the
/// portfolio is decided by the family: the parent's share link and "Public projects".
model PortfolioItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  projectId   String   @unique @map("project_id") @db.Uuid
  moduleId    String   @map("module_id")
  version     Int      @default(1)
  /// Storage keys per file: { "html": "projects/<user>/<project>/v2/index.html", … }.
  files       Json
  /// When this version was shipped.
  publishedAt DateTime @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id])

  @@index([userId, publishedAt])
  @@map("portfolio_items")
}

// ── XP, levels and streaks ───────────────────────────────────────────────────

enum XpSource {
  CHALLENGE
  LESSON
  PROJECT
  /// A quiz answered correctly the first time (Phase 1b).
  QUIZ
  /// Today's practice finished (source ID: the student's day, e.g. 2026-10-01).
  PRACTICE
  /// Corrections by staff (Sprint 5), with a written reason in the audit log.
  ADMIN
}

/// Every XP gain. Never changed or deleted (database trigger): totals, streaks and
/// leaderboards are all rebuilt from these rows.
model XpEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Int
  source    XpSource
  /// What earned it, e.g. the challenge ID. XP is given once per thing.
  sourceId  String   @map("source_id")
  /// The student's own date (their country's time zone): daily cap, streaks and the
  /// week and season an XP gain counts for.
  day       DateTime @db.Date
  /// Staff corrections (negative amounts): why. Also in the audit log.
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  // No cascade: accounts are anonymised, never removed, and XP history stays.
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, source, sourceId])
  @@index([userId, day])
  @@index([day])
  @@index([createdAt])
  @@map("xp_events")
}

/// XP needed for each level (seeded).
model Level {
  number Int @id
  minXp  Int @unique @map("min_xp")

  @@map("levels")
}

/// The daily goal streak: days in a row on which the student met their goal.
model Streak {
  userId      String    @id @map("user_id") @db.Uuid
  current     Int       @default(0)
  longest     Int       @default(0)
  /// The last day (student's time zone) on which the goal was met.
  lastGoalDay DateTime? @map("last_goal_day") @db.Date
  dailyGoalXp Int       @default(20) @map("daily_goal_xp")
  /// Streak freezes held (at most 2): each one covers a missed day. One is earned
  /// every 7 days of streak.
  freezes     Int       @default(0)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

enum BadgeCategory {
  SKILL
  SHIPPING
  STREAK
  LEVEL
  LEADERBOARD
  HELPING
}

/// Badges students can earn. Names and descriptions live in packages/i18n
/// (badges.<key>), so every language has them; the seed keeps this table in step.
model Badge {
  key       String        @id
  category  BadgeCategory
  /// How it is earned, e.g. { "type": "lessons_completed", "min": 5 }. "manual"
  /// badges are given by staff; "weekly_top" by the weekly results job.
  criteria  Json
  /// A single emoji, shown next to the name.
  icon      String
  sortOrder Int           @default(0) @map("sort_order")
  isActive  Boolean       @default(true) @map("is_active")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId      String    @map("user_id") @db.Uuid
  badgeKey    String    @map("badge_key")
  awardedAt   DateTime  @default(now()) @map("awarded_at")
  /// When the student saw the celebration; null shows it next time.
  seenAt      DateTime? @map("seen_at")
  /// Staff awards: who gave it, and why.
  awardedById String?   @map("awarded_by_id") @db.Uuid
  reason      String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeKey], references: [key])

  @@id([userId, badgeKey])
  @@index([badgeKey])
  @@map("user_badges")
}

enum SeasonStatus {
  ACTIVE
  ENDED
}

/// A leaderboard season, run by staff (e.g. "Autumn 2026"). Counts XP earned from
/// startDay up to (not including) endDay, by each student's own date. At most one is
/// active (a partial unique index).
model LeaderboardSeason {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  startDay    DateTime     @map("start_day") @db.Date
  /// The day after the last day; null while the end isn't planned.
  endDay      DateTime?    @map("end_day") @db.Date
  status      SeasonStatus @default(ACTIVE)
  createdById String?      @map("created_by_id") @db.Uuid
  endedById   String?      @map("ended_by_id") @db.Uuid
  endedAt     DateTime?    @map("ended_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  results LeaderboardResult[]

  @@index([status])
  @@map("leaderboard_seasons")
}

enum BoardPeriod {
  WEEK
  SEASON
}

enum BoardScope {
  GLOBAL
  COUNTRY
  REGION
  CITY
}

/// The final top 10 of a board once its week or season is over.
model LeaderboardResult {
  id        String      @id @default(uuid(7)) @db.Uuid
  period    BoardPeriod
  /// "2026-W40" for a week, the season ID for a season.
  periodKey String      @map("period_key")
  seasonId  String?     @map("season_id") @db.Uuid
  scope     BoardScope
  /// Country code, region or city ID; "" for the global board.
  scopeId   String      @default("") @map("scope_id")
  rank      Int
  userId    String      @map("user_id") @db.Uuid
  xp        Int
  createdAt DateTime    @default(now()) @map("created_at")

  season LeaderboardSeason? @relation(fields: [seasonId], references: [id])
  // No cascade: accounts are anonymised, never removed.
  user   User               @relation(fields: [userId], references: [id])

  @@unique([period, periodKey, scope, scopeId, userId])
  @@index([period, periodKey, scope, scopeId, rank])
  @@index([userId])
  @@map("leaderboard_results")
}

// ── Leagues and friends ──────────────────────────────────────────────────────

enum LeagueOutcome {
  PROMOTED
  STAYED
  RELEGATED
}

/// About 30 students of one league tier (and a similar level) competing on XP for one
/// week. Students join a group of their tier with the first XP they earn that week.
model LeagueGroup {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// "2026-W40": the students' own week (xp_events.day).
  weekKey     String    @map("week_key")
  tier        Int       @db.SmallInt
  /// Students of similar levels compete together (LEAGUE_LEVEL_BANDS).
  levelBand   Int       @map("level_band") @db.SmallInt
  memberCount Int       @default(0) @map("member_count")
  /// Ranks and outcomes are final.
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  members LeagueMembership[]

  @@index([weekKey, tier, levelBand, closedAt])
  @@index([closedAt, weekKey])
  @@map("league_groups")
}

/// A student in a league group for a week: their XP that week, then rank and outcome.
model LeagueMembership {
  id        String         @id @default(uuid(7)) @db.Uuid
  groupId   String         @map("group_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  weekKey   String         @map("week_key")
  /// The tier the student played this week in.
  tier      Int            @db.SmallInt
  xp        Int            @default(0)
  /// Ties go to whoever got there first.
  lastXpAt  DateTime       @default(now()) @map("last_xp_at")
  rank      Int?
  outcome   LeagueOutcome?
  /// The student saw the result (the league page celebrates it once).
  seenAt    DateTime?      @map("seen_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  group LeagueGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // No cascade: accounts are anonymised, never removed.
  user  User        @relation(fields: [userId], references: [id])

  @@unique([userId, weekKey])
  @@index([groupId, xp])
  @@map("league_memberships")
}

enum FriendRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
  EXPIRED
}

/// A student asks another (by their friend code) to be friends. Both children's parents
/// must approve before they become friends; either can say no.
model FriendRequest {
  id                   String              @id @default(uuid(7)) @db.Uuid
  fromId               String              @map("from_id") @db.Uuid
  toId                 String              @map("to_id") @db.Uuid
  status               FriendRequestStatus @default(PENDING)
  fromParentApprovedAt DateTime?           @map("from_parent_approved_at")
  fromParentId         String?             @map("from_parent_id") @db.Uuid
  toParentApprovedAt   DateTime?           @map("to_parent_approved_at")
  toParentId           String?             @map("to_parent_id") @db.Uuid
  /// The parent who said no, or the student who cancelled.
  decidedById          String?             @map("decided_by_id") @db.Uuid
  decidedAt            DateTime?           @map("decided_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  from User @relation("FriendRequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("FriendRequestTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, status])
  @@index([toId, status])
  @@index([status, createdAt])
  @@map("friend_requests")
}

/// Two students who are friends (userAId < userBId). Either child or parent can end it.
model Friendship {
  id        String   @id @default(uuid(7)) @db.Uuid
  userAId   String   @map("user_a_id") @db.Uuid
  userBId   String   @map("user_b_id") @db.Uuid
  requestId String?  @unique @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friendships")
}

// ── Referrals, activity and weekly reports ───────────────────────────────────

enum PremiumGrantSource {
  STAFF
  REFERRAL
  SCHOOL
}

enum ReferralStatus {
  PENDING
  REWARDED
  NOT_REWARDED
}

/// A family that signed up with another parent's invite link. It pays off (premium
/// days for the inviting family's children) when the new family's child ships their
/// first project, at most REFERRAL_MAX_PER_YEAR times a year.
model Referral {
  id                 String         @id @default(uuid(7)) @db.Uuid
  referrerId         String         @map("referrer_id") @db.Uuid
  inviteeId          String         @unique @map("invitee_id") @db.Uuid
  status             ReferralStatus @default(PENDING)
  /// Why there was no reward: SAME_NETWORK, SAME_FAMILY, YEARLY_LIMIT, REFERRER_GONE.
  reason             String?
  /// HMAC of the new parent's network at sign-up (never the address itself).
  inviteeNetworkHash String?        @map("invitee_network_hash")
  rewardDays         Int?           @map("reward_days")
  decidedAt          DateTime?      @map("decided_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  referrer User           @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  invitee  User           @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  grants   PremiumGrant[]

  @@index([referrerId, status, decidedAt])
  @@map("referrals")
}

/// Minutes a student spent learning on a day (their date), from the apps' heartbeats.
model StudentActivityDay {
  userId    String   @map("user_id") @db.Uuid
  day       DateTime @db.Date
  minutes   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("student_activity_days")
}

/// A parent's weekly report (Sunday evening, their time): each child's week.
model ParentReport {
  id        String    @id @default(uuid(7)) @db.Uuid
  parentId  String    @map("parent_id") @db.Uuid
  /// "2026-W40".
  weekKey   String    @map("week_key")
  /// { children: [{ childId, nickname, avatarKey, minutes, xp, lessons, streak, league, badges, skills }] }
  data      Json
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([parentId, weekKey])
  @@map("parent_reports")
}

/// A skill lessons teach (content/skills.yaml), shown on the skill map.
model Skill {
  key       String   @id
  /// logic, web or python.
  category  String
  /// Name per language code.
  names     Json
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("skills")
}

// ── Rooms and moderation ─────────────────────────────────────────────────────

enum ChatRoomKind {
  TEAM
  CLASS
  EVENT
  /// A hub project's team and its lead developer (never the client).
  HUB
}

enum ChatMemberRole {
  MEMBER
  /// A teacher or mentor in the room (adults: they read and write, never report).
  ADULT
}

enum ChatMessageKind {
  /// A ready-made phrase (every student can send these; the only kind for under-13s).
  PHRASE
  /// Typed text (13 and older), filtered before it is stored.
  TEXT
}

enum ChatReportReason {
  UNKIND
  PERSONAL_INFO
  SPAM
  SCARY
  OTHER
}

enum ChatReportStatus {
  OPEN
  RESOLVED
}

enum ModerationActionKind {
  WARN
  MUTE
  SUSPEND
  HIDE
  DISMISS
}

/// A room for a team, a class or an event. Only its members see it (and their parents).
model ChatRoom {
  id         String       @id @default(uuid(7)) @db.Uuid
  kind       ChatRoomKind
  /// The team, class or event it belongs to.
  refId      String?      @map("ref_id")
  name       String
  isArchived Boolean      @default(false) @map("is_archived")
  createdAt  DateTime     @default(now()) @map("created_at")

  members  ChatMember[]
  messages ChatMessage[]
  reports  ChatReport[]

  @@unique([kind, refId])
  @@map("chat_rooms")
}

model ChatMember {
  roomId     String         @map("room_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  role       ChatMemberRole @default(MEMBER)
  joinedAt   DateTime       @default(now()) @map("joined_at")
  lastReadAt DateTime?      @map("last_read_at")

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
  @@map("chat_members")
}

/// A message: a phrase key, or text that passed the filter. Kept CHAT_RETENTION_DAYS.
model ChatMessage {
  id         String          @id @default(uuid(7)) @db.Uuid
  roomId     String          @map("room_id") @db.Uuid
  authorId   String          @map("author_id") @db.Uuid
  kind       ChatMessageKind
  phraseKey  String?         @map("phrase_key")
  text       String?
  /// Removed by a moderator: shown as "Message removed".
  hiddenAt   DateTime?       @map("hidden_at")
  hiddenById String?         @map("hidden_by_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at")

  room    ChatRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author  User         @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reports ChatReport[]

  @@index([roomId, createdAt])
  @@index([createdAt])
  @@map("chat_messages")
}

/// Someone reported a message (or a member). Moderators see it with its context.
model ChatReport {
  id           String           @id @default(uuid(7)) @db.Uuid
  reporterId   String           @map("reporter_id") @db.Uuid
  roomId       String?          @map("room_id") @db.Uuid
  messageId    String?          @map("message_id") @db.Uuid
  /// The student the report is about.
  subjectId    String           @map("subject_id") @db.Uuid
  reason       ChatReportReason
  /// The message as it was when reported (it may be hidden or deleted since).
  snapshot     String?
  status       ChatReportStatus @default(OPEN)
  resolvedById String?          @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?        @map("resolved_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  reporter User               @relation("ChatReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  subject  User               @relation("ChatReportSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  room     ChatRoom?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  message  ChatMessage?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  actions  ModerationAction[]

  @@index([status, createdAt])
  @@index([subjectId])
  @@map("chat_reports")
}

/// What a moderator did, and why (also in the audit log).
model ModerationAction {
  id        String               @id @default(uuid(7)) @db.Uuid
  kind      ModerationActionKind
  subjectId String               @map("subject_id") @db.Uuid
  reportId  String?              @map("report_id") @db.Uuid
  messageId String?              @map("message_id") @db.Uuid
  staffId   String               @map("staff_id") @db.Uuid
  reason    String
  /// MUTE: until when.
  until     DateTime?
  createdAt DateTime             @default(now()) @map("created_at")

  subject User        @relation("ModerationSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  staff   User        @relation("ModerationStaff", fields: [staffId], references: [id])
  report  ChatReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([subjectId, createdAt])
  @@map("moderation_actions")
}

/// Words the text filter refuses, added by staff (on top of the built-in lists).
model BlockedTerm {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Stored normalised (lower case, no marks), as the filter compares.
  term        String   @unique
  /// en, ar, ur or roman-ur; "any" for names of apps and the like.
  language    String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("blocked_terms")
}

// ── Hackathons and team git (Pro) ───────────────────────────────────────────

enum EventStatus {
  /// Staff are setting it up: students don't see it.
  DRAFT
  /// Teams form (a join code; a parent approves each member).
  OPEN
  /// Teams build in their repositories (pushing is allowed).
  RUNNING
  /// Submissions are closed; judges score them.
  JUDGING
  /// Results are published.
  FINISHED
}

/// A hackathon: teams of students build a web project together in a git repository.
model Event {
  id          String      @id @default(uuid(7)) @db.Uuid
  slug        String      @unique
  title       String
  description String
  status      EventStatus @default(DRAFT)
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime    @map("ends_at")
  teamSize    Int         @default(3) @map("team_size") @db.SmallInt
  /// Students this age and older can take part.
  minAge      Int         @default(13) @map("min_age") @db.SmallInt
  /// Judging criteria: [{ key, label, max }].
  rubric      Json
  /// The files each team's repository starts with: { path: content }.
  starter     Json
  /// The organisation on the git server that holds the teams' repositories.
  gitOrg      String?     @map("git_org")
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  teams     EventTeam[]
  judges    EventJudge[]

  @@index([status])
  @@map("events")
}

model EventTeam {
  id        String   @id @default(uuid(7)) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  /// Chosen by the team (checked like a nickname).
  name      String
  /// Given to friends to join the team.
  joinCode  String   @unique @map("join_code")
  /// The mentor who reviews the team's pull requests.
  mentorId  String?  @map("mentor_id") @db.Uuid
  /// The repository on the git server ("org/name"), made when the team first opens it.
  repo      String?
  /// Once results are published.
  rank      Int?     @db.SmallInt
  score     Float?
  createdAt DateTime @default(now()) @map("created_at")

  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mentor     User?             @relation("EventTeamMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  members    EventTeamMember[]
  submission EventSubmission?
  scores     EventScore[]

  @@unique([eventId, name])
  @@map("event_teams")
}

enum EventMemberStatus {
  /// Waiting for a parent's OK.
  PENDING
  APPROVED
}

model EventTeamMember {
  teamId       String            @map("team_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  /// A student is in one team per event.
  eventId      String            @map("event_id") @db.Uuid
  status       EventMemberStatus @default(PENDING)
  /// Made the team.
  isCaptain    Boolean           @default(false) @map("is_captain")
  approvedById String?           @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?         @map("approved_at")
  joinedAt     DateTime          @default(now()) @map("joined_at")

  team       EventTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User      @relation("EventTeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?     @relation("EventTeamMemberApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@id([teamId, userId])
  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_team_members")
}

/// What a team hands in: a title, a short description, and the commit on main.
model EventSubmission {
  id            String   @id @default(uuid(7)) @db.Uuid
  teamId        String   @unique @map("team_id") @db.Uuid
  title         String
  description   String
  /// The commit on main that was handed in.
  commit        String?
  submittedById String   @map("submitted_by_id") @db.Uuid
  submittedAt   DateTime @default(now()) @map("submitted_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  team        EventTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedBy User      @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@map("event_submissions")
}

/// Mentors who score an event's submissions.
model EventJudge {
  eventId String @map("event_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_judges")
}

model EventScore {
  id        String   @id @default(uuid(7)) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  judgeId   String   @map("judge_id") @db.Uuid
  /// Criterion key → points.
  scores    Json
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team  EventTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  judge User      @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([teamId, judgeId])
  @@map("event_scores")
}

/// A student's or mentor's account on the git server (made when first needed).
model GitAccount {
  userId    String   @id @map("user_id") @db.Uuid
  username  String   @unique
  gitId     Int      @map("git_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("git_accounts")
}

// ── Schools ──────────────────────────────────────────────────────────────────

/// A school that runs classes on the platform, under a licence it pays for by invoice.
model School {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  countryCode  String   @map("country_code") @db.Char(2)
  city         String?
  /// Who we deal with at the school (invoices, questions). Staff only.
  contactName  String   @map("contact_name")
  contactEmail String   @map("contact_email")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  country  Country         @relation(fields: [countryCode], references: [code])
  teachers SchoolTeacher[]
  licenses SchoolLicense[]
  classes  SchoolClass[]

  @@map("schools")
}

/// A teacher account that teaches at a school (a teacher may teach at several).
model SchoolTeacher {
  schoolId String   @map("school_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  addedAt  DateTime @default(now()) @map("added_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([schoolId, userId])
  @@index([userId])
  @@map("school_teachers")
}

/// A year (or term) of premium for a number of students, invoiced and paid by bank
/// transfer. Premium applies once it is paid, between its dates, up to its seats.
model SchoolLicense {
  id               String    @id @default(uuid(7)) @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  seats            Int
  startsAt         DateTime  @map("starts_at")
  endsAt           DateTime  @map("ends_at")
  invoiceNumber    String    @unique @map("invoice_number")
  amountMinor      Int       @map("amount_minor")
  currency         String    @db.Char(3)
  paidAt           DateTime? @map("paid_at")
  /// The bank transfer's reference, when it is paid.
  paymentReference String?   @map("payment_reference")
  cancelledAt      DateTime? @map("cancelled_at")
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  grants    PremiumGrant[]

  @@index([schoolId, endsAt])
  @@map("school_licenses")
}

/// A teacher's class: students join with its code, once a parent approves.
model SchoolClass {
  id         String    @id @default(uuid(7)) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  teacherId  String    @map("teacher_id") @db.Uuid
  name       String
  joinCode   String    @unique @map("join_code")
  /// The track the class follows (for choosing lessons to assign).
  trackId    String?   @map("track_id")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     User          @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  track       Track?        @relation(fields: [trackId], references: [id], onDelete: SetNull)
  members     ClassMember[]
  assignments Assignment[]

  @@index([teacherId])
  @@index([schoolId])
  @@map("classes")
}

enum ClassMemberStatus {
  /// Waiting for a parent's OK.
  PENDING
  APPROVED
}

model ClassMember {
  classId      String            @map("class_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  status       ClassMemberStatus @default(PENDING)
  requestedAt  DateTime          @default(now()) @map("requested_at")
  approvedById String?           @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?         @map("approved_at")

  class      SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user       User        @relation("ClassMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?       @relation("ClassMemberApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@id([classId, userId])
  @@index([userId])
  @@map("class_members")
}

/// A lesson a teacher set for the class, with an optional date to finish it by.
model Assignment {
  id          String    @id @default(uuid(7)) @db.Uuid
  classId     String    @map("class_id") @db.Uuid
  lessonId    String    @map("lesson_id")
  dueAt       DateTime? @map("due_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson    Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([classId, lessonId])
  @@map("assignments")
}

// ── Hub readiness ────────────────────────────────────────────────────────────

enum ReadinessStatus {
  /// The timer is running.
  STARTED
  /// Handed in (or the time ran out with work saved): a mentor grades it.
  SUBMITTED
  PASSED
  NOT_PASSED
  /// The time ran out with nothing saved.
  EXPIRED
}

/// The hub readiness check: a timed practical project a mentor grades. Passing records
/// readiness only; it doesn't make a student eligible for hub work.
model ReadinessCheck {
  id          String          @id @default(uuid(7)) @db.Uuid
  studentId   String          @map("student_id") @db.Uuid
  status      ReadinessStatus @default(STARTED)
  startedAt   DateTime        @default(now()) @map("started_at")
  dueAt       DateTime        @map("due_at")
  /// The work so far: { html, css, js }.
  files       Json            @default("{}")
  submittedAt DateTime?       @map("submitted_at")
  /// The mentor's review (kind READINESS) once handed in.
  reviewId    String?         @unique @map("review_id") @db.Uuid
  /// The rubric total when graded.
  score       Int?            @db.SmallInt
  decidedAt   DateTime?       @map("decided_at")
  passedAt    DateTime?       @map("passed_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  review  Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([studentId, startedAt])
  @@index([status])
  @@map("readiness_checks")
}

// ── Pilot tools ──────────────────────────────────────────────────────────────

enum FeedbackKind {
  BUG
  IDEA
  PRAISE
  OTHER
  /// "Something here isn't safe" — first in the admin inbox.
  SAFETY
}

enum FeedbackStatus {
  NEW
  READ
  DONE
}

/// Sent with the in-app feedback button. Only staff read it.
model Feedback {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String?        @map("user_id") @db.Uuid
  kind         FeedbackKind
  message      String
  /// The page it was sent from, without query or fragment.
  pagePath     String?        @map("page_path")
  languageCode String         @map("language_code")
  status       FeedbackStatus @default(NEW)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("feedback")
}

/// Premium given by hand (pilot families, schools, support). Works next to subscriptions.
model PremiumGrant {
  id          String             @id @default(uuid(7)) @db.Uuid
  /// The student who gets premium.
  userId      String             @map("user_id") @db.Uuid
  /// The staff member; null for grants the platform gives (referral rewards).
  grantedById String?            @map("granted_by_id") @db.Uuid
  source      PremiumGrantSource @default(STAFF)
  /// The referral that earned it (source REFERRAL).
  referralId  String?            @map("referral_id") @db.Uuid
  /// The school licence that pays for it (source SCHOOL).
  licenseId   String?            @map("license_id") @db.Uuid
  reason      String
  startsAt    DateTime           @default(now()) @map("starts_at")
  endsAt      DateTime           @map("ends_at")
  revokedAt   DateTime?          @map("revoked_at")
  revokedById String?            @map("revoked_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")

  user      User           @relation("PremiumGrantStudent", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?          @relation("PremiumGrantStaff", fields: [grantedById], references: [id])
  referral  Referral?      @relation(fields: [referralId], references: [id])
  license   SchoolLicense? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  revokedBy User?          @relation("PremiumGrantRevoker", fields: [revokedById], references: [id])

  @@index([userId, endsAt])
  @@index([licenseId])
  @@map("premium_grants")
}

/// The five numbers, per day and country, written by the nightly job.
model MetricsDaily {
  day           DateTime @db.Date
  countryCode   String   @map("country_code") @db.Char(2)
  /// Parent accounts whose first child was created that day.
  signUps       Int      @default(0) @map("sign_ups")
  /// Students who shipped their first project that day.
  firstProjects Int      @default(0) @map("first_projects")
  /// Students with an XP event in the 7 days up to and including that day.
  weeklyActive  Int      @default(0) @map("weekly_active")
  /// From Sprint 6 (payments).
  payingParents Int      @default(0) @map("paying_parents")
  cancellations Int      @default(0)
  computedAt    DateTime @default(now()) @map("computed_at")

  @@id([day, countryCode])
  @@map("metrics_daily")
}

// ─── Payments (Sprint 6) ─────────────────────────────────────────────────────
// A family (the parent's account) subscribes; every child of theirs gets premium.
// Amounts are in the currency's minor unit (paisa, piastres, fils, halalas).

enum BillingInterval {
  MONTH
  YEAR
}

enum PaymentProvider {
  /// Recorded by staff: bank transfer, mobile wallet, cash.
  MANUAL
  /// Cards, through Stripe Checkout (a mock of Stripe in development).
  STRIPE
}

enum SubscriptionStatus {
  ACTIVE
  /// A renewal payment failed; the provider is retrying. Premium stays until the period ends.
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
  REFUNDED
}

/// What families can buy. Names and descriptions come from the translations.
model Plan {
  /// "monthly" or "yearly".
  key       String          @id
  interval  BillingInterval
  isActive  Boolean         @default(true) @map("is_active")
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")

  prices        PlanPrice[]
  subscriptions Subscription[]

  @@map("plans")
}

/// A plan's price for one child in one country, in that country's currency.
model PlanPrice {
  id          String   @id @default(uuid(7)) @db.Uuid
  planKey     String   @map("plan_key")
  countryCode String   @map("country_code") @db.Char(2)
  /// ISO 4217, the country's currency.
  currency    String   @db.Char(3)
  amountMinor Int      @map("amount_minor")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  plan    Plan    @relation(fields: [planKey], references: [key])
  country Country @relation(fields: [countryCode], references: [code])

  @@unique([planKey, countryCode])
  @@map("plan_prices")
}

/// The family's account at a payment provider (Stripe's customer ID).
model BillingCustomer {
  parentId   String          @map("parent_id") @db.Uuid
  provider   PaymentProvider
  customerId String          @map("customer_id")
  createdAt  DateTime        @default(now()) @map("created_at")

  parent User @relation(fields: [parentId], references: [id])

  @@id([parentId, provider])
  @@unique([provider, customerId])
  @@map("billing_customers")
}

/// A family's premium subscription. Only one is live (ACTIVE or PAST_DUE) at a time.
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  parentId               String             @map("parent_id") @db.Uuid
  planKey                String             @map("plan_key")
  provider               PaymentProvider
  status                 SubscriptionStatus
  currency               String             @db.Char(3)
  /// One period for the whole family, family discount included.
  amountMinor            Int                @map("amount_minor")
  /// Children the price was worked out for (every child is covered).
  children               Int                @default(1)
  /// Stripe's subscription ID ("sub_…"); null for manual subscriptions.
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  /// Cancelled by the family: premium stays until the period ends, then stops.
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  /// When premium actually stopped (period over, refunded or cancelled right away).
  endedAt                DateTime?          @map("ended_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  parent   User      @relation(fields: [parentId], references: [id])
  plan     Plan      @relation(fields: [planKey], references: [key])
  payments Payment[]
  invoices Invoice[]

  @@index([parentId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Money received (or tried): a card payment through Stripe, or a manual one.
model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  parentId          String          @map("parent_id") @db.Uuid
  subscriptionId    String?         @map("subscription_id") @db.Uuid
  provider          PaymentProvider
  /// Stripe's payment intent ("pi_…"); null for manual payments.
  providerPaymentId String?         @map("provider_payment_id")
  status            PaymentStatus
  currency          String          @db.Char(3)
  amountMinor       Int             @map("amount_minor")
  refundedMinor     Int             @default(0) @map("refunded_minor")
  /// Manual payments: how the family paid, e.g. "Bank transfer", and the bank's reference.
  method            String?
  reference         String?
  /// Staff member who recorded a manual payment.
  recordedById      String?         @map("recorded_by_id") @db.Uuid
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  parent       User          @relation("PaymentParent", fields: [parentId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  recordedBy   User?         @relation("PaymentRecorder", fields: [recordedById], references: [id])
  invoice      Invoice?
  refunds      Refund[]

  @@unique([provider, providerPaymentId])
  @@index([parentId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// Money given back, always with a reason.
model Refund {
  id               String   @id @default(uuid(7)) @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  amountMinor      Int      @map("amount_minor")
  reason           String
  /// Stripe's refund ID ("re_…"); null for manual refunds.
  providerRefundId String?  @unique @map("provider_refund_id")
  /// Null when the provider reported a refund made outside the admin panel.
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  payment   Payment @relation(fields: [paymentId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

/// Our invoice (receipt) for one period. Numbered in order: KCP-000001, KCP-000002…
model Invoice {
  id                String        @id @default(uuid(7)) @db.Uuid
  number            Int           @unique @default(autoincrement())
  parentId          String        @map("parent_id") @db.Uuid
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  paymentId         String?       @unique @map("payment_id") @db.Uuid
  /// Stripe's invoice ID ("in_…"): the same Stripe invoice never makes two of ours.
  providerInvoiceId String?       @unique @map("provider_invoice_id")
  status            InvoiceStatus
  currency          String        @db.Char(3)
  amountMinor       Int           @map("amount_minor")
  /// [{ "kind": "first" | "extra", "quantity": 1, "unitMinor": 150000 }]
  lines             Json
  periodStart       DateTime      @map("period_start")
  periodEnd         DateTime      @map("period_end")
  issuedAt          DateTime      @default(now()) @map("issued_at")
  paidAt            DateTime?     @map("paid_at")

  parent       User          @relation(fields: [parentId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payment      Payment?      @relation(fields: [paymentId], references: [id])

  @@index([parentId, issuedAt])
  @@map("invoices")
}

/// Everything that happened to payments, as it arrived: provider webhooks and staff
/// actions. Append-only. The unique event ID makes each webhook count once.
model PaymentEvent {
  id             String          @id @default(uuid(7)) @db.Uuid
  provider       PaymentProvider
  /// Stripe's event ID ("evt_…"), or ours for manual actions.
  eventId        String          @map("event_id")
  type           String
  parentId       String?         @map("parent_id") @db.Uuid
  subscriptionId String?         @map("subscription_id") @db.Uuid
  paymentId      String?         @map("payment_id") @db.Uuid
  /// Staff member, for manual payments and refunds.
  actorId        String?         @map("actor_id") @db.Uuid
  /// The event's data (providers never send full card numbers).
  payload        Json
  createdAt      DateTime        @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([parentId, createdAt])
  @@map("payment_events")
}

// ─── Sprint 7: waitlist, notifications, certificates ─────────────────────────

enum WaitlistAgeBand {
  AGE_9_12
  AGE_13_16
}

/// Families waiting for the platform to open in their country (the marketing site).
/// Double opt-in: an entry counts once the email address is confirmed.
model WaitlistEntry {
  id             String          @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase.
  email          String          @unique
  countryCode    String          @map("country_code") @db.Char(2)
  ageBand        WaitlistAgeBand @map("age_band")
  languageCode   String          @map("language_code")
  /// SHA-256 of the link's token (the token itself is only in the email).
  tokenHash      String?         @unique @map("token_hash")
  tokenExpiresAt DateTime?       @map("token_expires_at")
  confirmedAt    DateTime?       @map("confirmed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([countryCode, confirmedAt])
  @@map("waitlist_entries")
}

/// A message in the app's bell: shown in the reader's language from `type` and `data`.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// e.g. "badge_earned", "certificate_issued", "payment_receipt", "trial_ending".
  type      String
  /// What the message needs, e.g. { "badgeKey": "first-ship" } (no free text from users).
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// A certificate for finishing a module (every lesson and its project). Anyone with
/// the code can check it is real; it shows the nickname only.
model Certificate {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Short and unguessable, e.g. "KCP-7F3K-9Q2M": printed on the certificate.
  code         String    @unique
  userId       String    @map("user_id") @db.Uuid
  moduleId     String    @map("module_id")
  /// As they were when it was issued (a certificate doesn't change afterwards).
  nickname     String
  moduleTitles Json      @map("module_titles")
  trackTitles  Json      @map("track_titles")
  issuedAt     DateTime  @default(now()) @map("issued_at")
  /// Staff can revoke one (for example after cheating); verification then says so.
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@map("certificates")
}

// ── Phase 1b: quizzes, practice, the mobile app ──────────────────────────────

enum QuizKind {
  /// Put the lines of code back in order.
  ORDER
  /// Tap the line with the mistake.
  BUG
  /// Pick what the code shows.
  OUTPUT
  /// A question about the lesson.
  CHOICE
}

/// A short question that works on a phone (and on the lesson page). The server
/// grades it: `answer` never leaves the API.
model Quiz {
  id           String   @id
  lessonId     String   @map("lesson_id")
  sortOrder    Int      @default(0) @map("sort_order")
  kind         QuizKind
  xp           Int      @default(5)
  /// html, css, js or python: how `code` is shown.
  codeLanguage String?  @map("code_language")
  /// The lines of code (string[]). For ORDER quizzes, in the right order.
  code         Json?
  /// [{ id, code? }]: options shown as code; text options are in `texts`.
  options      Json?
  /// BUG: { line } (from 1); OUTPUT and CHOICE: { option }; ORDER: {} (the order of `code`).
  answer       Json
  /// Per language: { prompt, explanation, options: { <option id>: text } }.
  texts        Json
  /// Per language: { source: "IMPORT" | "STUDIO", importHash } (see LessonTranslation).
  textSources  Json     @default("{}") @map("text_sources")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lesson   Lesson        @relation(fields: [lessonId], references: [id])
  attempts QuizAttempt[]

  @@index([lessonId, sortOrder])
  @@map("quizzes")
}

/// Every answer a student sends (right or wrong); the first right one earns the XP.
model QuizAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  quizId    String   @map("quiz_id")
  correct   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id])

  @@index([userId, quizId])
  @@index([userId, createdAt])
  @@map("quiz_attempts")
}

/// A student's daily practice: a few quizzes picked once per day (the student's own
/// day). Finishing it earns PRACTICE XP, enough for the default daily goal.
model PracticeSession {
  userId      String    @map("user_id") @db.Uuid
  day         DateTime  @db.Date
  /// The quiz IDs picked for the day (string[]).
  quizIds     Json      @map("quiz_ids")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("practice_sessions")
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// A phone that gets push notifications for a signed-in account. Pushes go only to
/// accounts with a live session; the app removes its token when it signs out.
model DeviceToken {
  id           String         @id @default(uuid(7)) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  /// The Firebase Cloud Messaging registration token.
  token        String         @unique
  platform     DevicePlatform
  /// The app's language, for the notification texts.
  languageCode String         @map("language_code")
  /// The sign-in on that phone: notifications go only while it lasts (it follows
  /// refresh-token rotation; signing out ends it).
  sessionId    String?        @map("session_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  lastSeenAt   DateTime       @default(now()) @map("last_seen_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("device_tokens")
}

/// A crash in the mobile app, sent by the app itself: no account, no device ID.
/// Kept for 90 days.
model AppCrash {
  id         String   @id @default(uuid(7)) @db.Uuid
  appVersion String   @map("app_version")
  platform   String
  osVersion  String   @map("os_version")
  fatal      Boolean
  message    String
  stack      String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("app_crashes")
}

// ── Phase 2 · Content studio ─────────────────────────────────────────────────
//
// Translators write and review texts in the admin panel. Students keep reading the
// live translation tables until a reviewer publishes a draft; every published text is
// kept in content_versions for history and restore.

enum ContentSource {
  IMPORT
  STUDIO
}

enum ContentEntity {
  LESSON
  CHALLENGE
  PROJECT
  QUIZ
}

enum ContentDraftStatus {
  DRAFT
  IN_REVIEW
}

enum ContentVersionAction {
  IMPORT
  PUBLISH
}

/// A translation being written: one per text and language.
model ContentDraft {
  entityType   ContentEntity      @map("entity_type")
  entityId     String             @map("entity_id")
  languageCode String             @map("language_code")
  /// The translated fields (see apps/api/src/content-studio/texts.ts).
  data         Json
  status       ContentDraftStatus @default(DRAFT)
  /// Who wrote the latest change. A different person publishes it.
  editedById   String?            @map("edited_by_id") @db.Uuid
  submittedAt  DateTime?          @map("submitted_at")
  /// Why a reviewer asked for changes.
  reviewNote   String?            @map("review_note")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  editedBy User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)
  language Language @relation(fields: [languageCode], references: [code])

  @@id([entityType, entityId, languageCode])
  @@index([status, updatedAt])
  @@map("content_drafts")
}

/// Every text that went live (imported or published). Append-only.
model ContentVersion {
  id           String               @id @default(uuid(7)) @db.Uuid
  entityType   ContentEntity        @map("entity_type")
  entityId     String               @map("entity_id")
  languageCode String               @map("language_code")
  data         Json
  action       ContentVersionAction
  /// The reviewer who published it (none for imports). No foreign keys: the history
  /// outlives the accounts it mentions.
  actorId      String?              @map("actor_id") @db.Uuid
  /// Who wrote it.
  editedById   String?              @map("edited_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([entityType, entityId, languageCode, createdAt])
  @@map("content_versions")
}

// ── Phase 2 · Mentors and reviews ────────────────────────────────────────────

enum BackgroundCheckStatus {
  NOT_STARTED
  PENDING
  PASSED
  FAILED
}

/// A mentor's onboarding (background check, code of conduct) and workload settings.
/// Mentors review only once their check passed and they signed the code of conduct.
model MentorProfile {
  userId                String                @id @map("user_id") @db.Uuid
  backgroundCheck       BackgroundCheckStatus @default(NOT_STARTED) @map("background_check")
  backgroundCheckedAt   DateTime?             @map("background_checked_at")
  /// Staff's note about the check (provider, reference). Never shown to families.
  backgroundCheckNote   String?               @map("background_check_note")
  codeOfConductVersion  String?               @map("code_of_conduct_version")
  codeOfConductSignedAt DateTime?             @map("code_of_conduct_signed_at")
  /// Languages they review in (language codes).
  languages             String[]              @default([])
  /// Reviews they may have open at once.
  capacity              Int                   @default(5)
  /// A lead developer: signs students off for the hub, scopes and leads client projects.
  isLead                Boolean               @default(false) @map("is_lead")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

enum ReviewKind {
  /// A shipped module project (premium students).
  PROJECT
  /// The hub readiness check (a timed practical project).
  READINESS
}

enum ReviewStatus {
  WAITING
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  /// No longer needed (e.g. the student's account was closed).
  CANCELLED
}

/// A mentor's review of a student's work. Mentors see the nickname only.
model Review {
  id              String       @id @default(uuid(7)) @db.Uuid
  kind            ReviewKind   @default(PROJECT)
  studentId       String       @map("student_id") @db.Uuid
  projectId       String?      @map("project_id") @db.Uuid
  /// The shipped version that is reviewed.
  version         Int          @default(1)
  /// The code as shipped: { html, css, js } or { py }.
  files           Json
  /// The student's language when they asked (mentors who speak it see it first).
  languageCode    String       @map("language_code")
  status          ReviewStatus @default(WAITING)
  mentorId        String?      @map("mentor_id") @db.Uuid
  requestedAt     DateTime     @default(now()) @map("requested_at")
  claimedAt       DateTime?    @map("claimed_at")
  decidedAt       DateTime?    @map("decided_at")
  /// Hours from the request to the decision (the target is under 48).
  turnaroundHours Float?       @map("turnaround_hours")
  /// Rubric scores by criterion, 1 to 4.
  scores          Json         @default("{}")
  /// The mentor's message to the student.
  summary         String?
  /// When the student opened the result.
  seenAt          DateTime?    @map("seen_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  student   User            @relation("ReviewStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor    User?           @relation("ReviewMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments  ReviewComment[]
  readiness ReadinessCheck?

  @@index([status, requestedAt])
  @@index([studentId, createdAt])
  @@index([mentorId, status])
  @@index([projectId])
  @@map("reviews")
}

/// A mentor's comment on one line of the student's code.
model ReviewComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  /// html, css, js or py.
  file      String
  line      Int
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@map("review_comments")
}

/// Notes about a student for other mentors (never shown to the student or family).
model MentorNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  student User  @relation("MentorNoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  author  User? @relation("MentorNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@map("mentor_notes")
}

// ── Phase 3: the real-world hub ──────────────────────────────────────────────

/// A student's way into paid hub work: the Pro track, the readiness check, a lead
/// developer's sign-off, both parent consents (hub work and earnings) to the current
/// parent agreement, the country's minimum age and an open hub in their country. The
/// steps are checked live; `eligibleAt` records the first time they were all met.
model HubEligibility {
  id            String    @id @default(uuid(7)) @db.Uuid
  studentId     String    @unique @map("student_id") @db.Uuid
  /// The passed readiness check the sign-off was based on.
  readinessId   String?   @map("readiness_id") @db.Uuid
  signedOffById String?   @map("signed_off_by_id") @db.Uuid
  signedOffAt   DateTime? @map("signed_off_at")
  /// The lead developer's note (for staff and other mentors).
  signOffNote   String?   @map("sign_off_note")
  eligibleAt    DateTime? @map("eligible_at")
  /// Staff paused the student's hub work (with a reason in the audit log).
  revokedAt     DateTime? @map("revoked_at")
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  revokedReason String?   @map("revoked_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  student     User  @relation("HubEligibilityStudent", fields: [studentId], references: [id], onDelete: Cascade)
  signedOffBy User? @relation("HubEligibilitySignOff", fields: [signedOffById], references: [id], onDelete: SetNull)
  revokedBy   User? @relation("HubEligibilityRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([eligibleAt])
  @@map("hub_eligibility")
}

enum LedgerAccountType {
  /// Money the platform holds (bank and card processor).
  CASH
  /// What a client organisation owes on invoices issued.
  CLIENT_RECEIVABLE
  /// A project's invoiced money, until the accepted work is shared out.
  PROJECT_FUNDS
  PLATFORM_REVENUE
  /// What the platform owes a lead developer.
  LEAD_PAYABLE
  /// A student's earnings while they are held (the hold period).
  STUDENT_HELD
  /// A student's earnings that can be paid out to their parent.
  STUDENT_PAYABLE
  /// Payouts sent and not yet confirmed by the provider.
  PAYOUT_CLEARING
  /// Withheld from payouts for tax, where the law asks for it.
  TAX_WITHHELD
}

enum LedgerSide {
  DEBIT
  CREDIT
}

/// An account in the hub's double-entry ledger, per currency. `ownerKey` is the owner's
/// ID (a client organisation, project, lead developer or student), or "" for the
/// platform's own accounts.
model LedgerAccount {
  id        String            @id @default(uuid(7)) @db.Uuid
  type      LedgerAccountType
  currency  String            @db.Char(3)
  ownerKey  String            @default("") @map("owner_key")
  createdAt DateTime          @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@unique([type, currency, ownerKey])
  @@map("ledger_accounts")
}

/// One posting: its entries balance (debits equal credits in each currency — checked
/// by the database when the transaction commits). Nothing is ever edited or deleted:
/// a mistake is put right by a new posting.
model LedgerTransaction {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// e.g. "invoice.issued", "invoice.paid", "earnings.shared", "earnings.released".
  kind           String
  memo           String
  /// What it is about, e.g. ("HubInvoice", id).
  refType        String?  @map("ref_type")
  refId          String?  @map("ref_id") @db.Uuid
  /// The same key never posts twice (retries, a webhook delivered twice).
  idempotencyKey String   @unique @map("idempotency_key")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@index([refType, refId])
  @@index([createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String     @id @default(uuid(7)) @db.Uuid
  transactionId String     @map("transaction_id") @db.Uuid
  accountId     String     @map("account_id") @db.Uuid
  side          LedgerSide
  /// Minor units (cents, paisa, piastres); always more than zero.
  amountMinor   Int        @map("amount_minor")
  currency      String     @db.Char(3)
  createdAt     DateTime   @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

enum ClientOrgStatus {
  ACTIVE
  SUSPENDED
}

/// A client: a business that brings projects to the hub. It signs the client agreement
/// with the platform; its people sign in to the client portal (two-factor login).
model ClientOrg {
  id                 String          @id @default(uuid(7)) @db.Uuid
  name               String
  countryCode        String          @map("country_code") @db.Char(2)
  /// On invoices.
  billingName        String?         @map("billing_name")
  billingAddress     String?         @map("billing_address")
  taxId              String?         @map("tax_id")
  /// The client agreement's version they signed (HUB_AGREEMENTS.client), and who and when.
  contractVersion    String?         @map("contract_version")
  contractSignedAt   DateTime?       @map("contract_signed_at")
  contractSignedById String?         @map("contract_signed_by_id") @db.Uuid
  status             ClientOrgStatus @default(ACTIVE)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  country          Country        @relation(fields: [countryCode], references: [code])
  contractSignedBy User?          @relation("ClientOrgSigner", fields: [contractSignedById], references: [id], onDelete: SetNull)
  members          ClientMember[]
  intakes          HubIntake[]
  projects         HubProject[]
  invoices         HubInvoice[]

  @@map("client_orgs")
}

enum ClientMemberRole {
  /// Signs the agreement, approves quotes, invites colleagues.
  OWNER
  MEMBER
}

model ClientMember {
  id        String           @id @default(uuid(7)) @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  /// A client account belongs to one organisation.
  userId    String           @unique @map("user_id") @db.Uuid
  role      ClientMemberRole @default(MEMBER)
  createdAt DateTime         @default(now()) @map("created_at")

  org  ClientOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("client_members")
}

enum HubIntakeStatus {
  /// From the marketing site: waiting for the contact to confirm their email.
  UNCONFIRMED
  /// In the admin Hub queue.
  NEW
  ACCEPTED
  DECLINED
}

enum HubIntakeSource {
  SITE
  PORTAL
}

/// What a client says they'll spend (US dollars, a rough range).
enum HubBudget {
  UNDER_500
  FROM_500
  FROM_2000
  FROM_5000
  UNSURE
}

/// A project request: from the "Hire our students" page or the client portal.
model HubIntake {
  id             String          @id @default(uuid(7)) @db.Uuid
  number         Int             @unique @default(autoincrement())
  source         HubIntakeSource
  status         HubIntakeStatus
  orgId          String?         @map("org_id") @db.Uuid
  createdById    String?         @map("created_by_id") @db.Uuid
  contactName    String          @map("contact_name")
  /// Stored lowercase.
  contactEmail   String          @map("contact_email")
  company        String
  countryCode    String?         @map("country_code") @db.Char(2)
  languageCode   String          @default("en") @map("language_code")
  title          String
  /// What they need (plain text).
  brief          String
  budget         HubBudget
  deadline       DateTime?       @db.Date
  /// [{ id, key, name, size, type }] — files in storage (hub/intakes/…), private.
  files          Json            @default("[]")
  /// Sites only: the email link (hashed) that confirms the request.
  tokenHash      String?         @unique @map("token_hash")
  tokenExpiresAt DateTime?       @map("token_expires_at")
  decidedById    String?         @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?       @map("decided_at")
  declineReason  String?         @map("decline_reason")
  createdAt      DateTime        @default(now()) @map("created_at")

  org       ClientOrg?  @relation(fields: [orgId], references: [id], onDelete: SetNull)
  createdBy User?       @relation("HubIntakeAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy User?       @relation("HubIntakeDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  project   HubProject?

  @@index([status, createdAt])
  @@index([orgId])
  @@map("hub_intakes")
}

enum HubProjectStatus {
  /// The lead developer splits the work into tasks.
  SCOPING
  /// The quote is with the client.
  QUOTED
  /// The client approved the quote: the deposit invoice is open.
  AWAITING_DEPOSIT
  /// The deposit is paid: the team works.
  ACTIVE
  /// The client accepted the final delivery: the final invoice is open.
  DELIVERED
  /// Paid in full and the earnings shared out.
  COMPLETED
  CANCELLED
}

/// A client project in the hub, led by a lead developer.
model HubProject {
  id               String           @id @default(uuid(7)) @db.Uuid
  number           Int              @unique @default(autoincrement())
  orgId            String           @map("org_id") @db.Uuid
  intakeId         String?          @unique @map("intake_id") @db.Uuid
  title            String
  /// What the client needs, as the platform understood it (shown to the team).
  summary          String
  status           HubProjectStatus @default(SCOPING)
  leadId           String?          @map("lead_id") @db.Uuid
  currency         String           @db.Char(3)
  /// The split for this project (from the client's country; adds up to 100).
  studentPercent   Int              @map("student_percent") @db.SmallInt
  leadPercent      Int              @map("lead_percent") @db.SmallInt
  platformPercent  Int              @map("platform_percent") @db.SmallInt
  /// Part of each main quote invoiced before work starts.
  depositPercent   Int              @default(30) @map("deposit_percent") @db.SmallInt
  deadline         DateTime?        @db.Date
  /// The team's repository on the git server, and its room.
  repo             String?
  /// The client allowed students to show the finished project in their portfolios.
  portfolioAllowed Boolean          @default(false) @map("portfolio_allowed")
  createdById      String?          @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  completedAt      DateTime?        @map("completed_at")
  cancelledAt      DateTime?        @map("cancelled_at")
  cancelReason     String?          @map("cancel_reason")

  org        ClientOrg          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  intake     HubIntake?         @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  lead       User?              @relation("HubProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("HubProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  quotes     HubQuote[]
  tasks      HubTask[]
  invoices   HubInvoice[]
  members    HubMember[]
  time       HubTimeEntry[]
  reviews    HubCodeReview[]
  deliveries HubDelivery[]
  comments   HubComment[]
  changes    HubChangeRequest[]
  earnings   HubEarning[]
  stories    HubStory[]

  @@index([orgId, createdAt])
  @@index([leadId, status])
  @@index([status])
  @@map("hub_projects")
}

enum HubQuoteKind {
  /// The project's first quote: a deposit before work, the rest on acceptance.
  MAIN
  /// Changes the client asked for beyond the statement of work.
  CHANGE
}

enum HubQuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  WITHDRAWN
}

/// A quote for (part of) a project: its tasks, price and deposit. Once the client
/// approves it, its statement of work (kept as approved) is part of their agreement.
model HubQuote {
  id            String         @id @default(uuid(7)) @db.Uuid
  projectId     String         @map("project_id") @db.Uuid
  /// 1, 2, 3… within the project.
  version       Int            @db.SmallInt
  kind          HubQuoteKind
  status        HubQuoteStatus @default(DRAFT)
  priceMinor    Int            @map("price_minor")
  depositMinor  Int            @default(0) @map("deposit_minor")
  /// For the client: what's in it, what isn't.
  note          String?
  /// The statement of work as the client saw it when it was sent (and approved).
  sowText       String?        @map("sow_text")
  sowVersion    String?        @map("sow_version")
  sentAt        DateTime?      @map("sent_at")
  approvedAt    DateTime?      @map("approved_at")
  approvedById  String?        @map("approved_by_id") @db.Uuid
  declinedAt    DateTime?      @map("declined_at")
  declineReason String?        @map("decline_reason")
  withdrawnAt   DateTime?      @map("withdrawn_at")
  /// The client accepted the work it covers (its final delivery).
  acceptedAt    DateTime?      @map("accepted_at")
  createdById   String?        @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  project    HubProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("HubQuoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?              @relation("HubQuoteApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  tasks      HubTask[]
  invoices   HubInvoice[]
  deliveries HubDelivery[]
  changes    HubChangeRequest[]

  @@unique([projectId, version])
  @@index([status])
  @@map("hub_quotes")
}

enum HubTaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

/// A piece of a project sized for one student: a spec, skills, an estimate and a share
/// of the students' pool (basis points; a quote's tasks add up to 10,000).
model HubTask {
  id              String        @id @default(uuid(7)) @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  quoteId         String        @map("quote_id") @db.Uuid
  /// 1, 2, 3… within the project ("T-3").
  number          Int           @db.SmallInt
  title           String
  /// What to build (Markdown, for the team).
  spec            String
  skillTags       String[]      @default([]) @map("skill_tags")
  estimateMinutes Int           @map("estimate_minutes")
  shareBp         Int           @map("share_bp")
  status          HubTaskStatus @default(TODO)
  assigneeId      String?       @map("assignee_id") @db.Uuid
  sortOrder       Int           @default(0) @map("sort_order")
  doneAt          DateTime?     @map("done_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  project  HubProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quote    HubQuote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  assignee User?           @relation("HubTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  invites  HubMember[]
  time     HubTimeEntry[]
  reviews  HubCodeReview[]

  @@unique([projectId, number])
  @@index([quoteId])
  @@index([assigneeId, status])
  @@map("hub_tasks")
}

enum HubInvoiceKind {
  DEPOSIT
  FINAL
}

enum HubInvoiceStatus {
  OPEN
  PAID
  VOID
}

/// A client's invoice for a quote: the deposit, or the rest once the work is accepted.
model HubInvoice {
  id                String           @id @default(uuid(7)) @db.Uuid
  /// "H-0042".
  number            Int              @unique @default(autoincrement())
  projectId         String           @map("project_id") @db.Uuid
  orgId             String           @map("org_id") @db.Uuid
  quoteId           String           @map("quote_id") @db.Uuid
  kind              HubInvoiceKind
  status            HubInvoiceStatus @default(OPEN)
  currency          String           @db.Char(3)
  amountMinor       Int              @map("amount_minor")
  issuedAt          DateTime         @default(now()) @map("issued_at")
  dueAt             DateTime         @map("due_at")
  paidAt            DateTime?        @map("paid_at")
  voidedAt          DateTime?        @map("voided_at")
  voidReason        String?          @map("void_reason")
  /// The card checkout page open for it (Stripe Checkout), if any.
  checkoutSessionId String?          @map("checkout_session_id")
  /// The money was shared out (team, lead, platform) in the ledger.
  distributedAt     DateTime?        @map("distributed_at")

  project  HubProject   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  org      ClientOrg    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  quote    HubQuote     @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  payments HubPayment[]
  earnings HubEarning[]

  @@unique([quoteId, kind])
  @@index([orgId, issuedAt])
  @@index([status])
  @@map("hub_invoices")
}

/// A payment of a client invoice: by card (Stripe) or recorded by staff (bank transfer).
model HubPayment {
  id                String          @id @default(uuid(7)) @db.Uuid
  invoiceId         String          @map("invoice_id") @db.Uuid
  provider          PaymentProvider
  /// Stripe's payment intent; null for payments staff record.
  providerPaymentId String?         @map("provider_payment_id")
  currency          String          @db.Char(3)
  amountMinor       Int             @map("amount_minor")
  /// Recorded payments: how, and the bank's reference.
  method            String?
  reference         String?
  recordedById      String?         @map("recorded_by_id") @db.Uuid
  paidAt            DateTime        @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  invoice    HubInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User?      @relation("HubPaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@index([invoiceId])
  @@map("hub_payments")
}

enum HubMemberStatus {
  /// The lead invited the student; they haven't answered.
  INVITED
  /// The student said yes; a parent approves next.
  ACCEPTED
  /// A parent approved: the student is on the team.
  APPROVED
  DECLINED
  REMOVED
}

/// A student on a hub project's team: invited by the lead, accepted by the student,
/// approved by a parent (for each project). Clients see them by pseudonym only.
model HubMember {
  id            String          @id @default(uuid(7)) @db.Uuid
  projectId     String          @map("project_id") @db.Uuid
  studentId     String          @map("student_id") @db.Uuid
  status        HubMemberStatus @default(INVITED)
  /// "Developer A": all a client ever sees of the student.
  pseudonym     String
  /// The task the student was invited for.
  taskId        String?         @map("task_id") @db.Uuid
  /// The lead's message to the student and their parent.
  note          String?
  invitedById   String?         @map("invited_by_id") @db.Uuid
  invitedAt     DateTime        @default(now()) @map("invited_at")
  answeredAt    DateTime?       @map("answered_at")
  parentId      String?         @map("parent_id") @db.Uuid
  decidedAt     DateTime?       @map("decided_at")
  /// Who said no: STUDENT or PARENT.
  declinedBy    String?         @map("declined_by")
  removedAt     DateTime?       @map("removed_at")
  removedReason String?         @map("removed_reason")

  project   HubProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student   User       @relation("HubMemberStudent", fields: [studentId], references: [id], onDelete: Cascade)
  task      HubTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  invitedBy User?      @relation("HubMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  parent    User?      @relation("HubMemberParent", fields: [parentId], references: [id], onDelete: SetNull)

  @@unique([projectId, studentId])
  @@unique([projectId, pseudonym])
  @@index([studentId, status])
  @@map("hub_members")
}

/// Time a student logs on a hub task (a timer). The system keeps it inside the weekly
/// cap and the allowed hours: a timer stops at the cap or when the allowed time ends.
model HubTimeEntry {
  id        String    @id @default(uuid(7)) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  startedAt DateTime  @map("started_at")
  /// Null while the timer runs.
  endedAt   DateTime? @map("ended_at")
  /// Counted minutes (set when the timer stops).
  minutes   Int       @default(0) @db.SmallInt
  /// The student's week ("2026-W41", their own time zone).
  weekKey   String    @map("week_key")
  /// Who stopped it: STUDENT, CAP, HOURS (allowed time ended), LEAD or SYSTEM.
  stoppedBy String?   @map("stopped_by")
  createdAt DateTime  @default(now()) @map("created_at")

  project HubProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    HubTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, weekKey])
  @@index([taskId])
  @@index([endedAt])
  @@map("hub_time_entries")
}

enum HubReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

/// The lead developer's review of a student's pull request: what lets it merge, and
/// a score (1–5) that builds the student's reputation for matching.
model HubCodeReview {
  id         String            @id @default(uuid(7)) @db.Uuid
  projectId  String            @map("project_id") @db.Uuid
  taskId     String?           @map("task_id") @db.Uuid
  studentId  String            @map("student_id") @db.Uuid
  reviewerId String?           @map("reviewer_id") @db.Uuid
  pullNumber Int               @map("pull_number")
  /// The commit reviewed.
  commit     String
  decision   HubReviewDecision
  /// 1 (needs a lot of work) … 5 (excellent).
  score      Int               @db.SmallInt
  comment    String?
  createdAt  DateTime          @default(now()) @map("created_at")

  project  HubProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     HubTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  student  User       @relation("HubCodeReviewStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reviewer User?      @relation("HubCodeReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([projectId, pullNumber])
  @@map("hub_code_reviews")
}

enum HubDeliveryStatus {
  SUBMITTED
  ACCEPTED
  CHANGES_REQUESTED
  WITHDRAWN
}

/// A milestone shown to the client: the repository's main branch at a commit, kept as
/// a static preview (in storage, opened on the sandbox domain with its secret link).
/// Accepting a quote's final delivery accepts its work and issues the final invoice.
model HubDelivery {
  id            String            @id @default(uuid(7)) @db.Uuid
  projectId     String            @map("project_id") @db.Uuid
  quoteId       String            @map("quote_id") @db.Uuid
  /// 1, 2, 3… within the project ("M-2").
  number        Int               @db.SmallInt
  title         String
  /// For the client: what's in it, what to look at.
  notes         String
  /// The quote's final delivery: accepting it accepts the quote's work.
  final         Boolean           @default(false)
  commit        String
  /// [{ path, size, type }] — files under hub/previews/<id>/ in storage.
  files         Json              @default("[]")
  /// The preview's secret link (after "#" on the sandbox domain).
  previewToken  String            @unique @map("preview_token")
  status        HubDeliveryStatus @default(SUBMITTED)
  submittedAt   DateTime          @default(now()) @map("submitted_at")
  decidedAt     DateTime?         @map("decided_at")
  decidedById   String?           @map("decided_by_id") @db.Uuid
  /// What the client asked to change (goes to the lead, never to students).
  clientComment String?           @map("client_comment")
  createdById   String?           @map("created_by_id") @db.Uuid

  project   HubProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quote     HubQuote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  decidedBy User?              @relation("HubDeliveryDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  createdBy User?              @relation("HubDeliveryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments  HubComment[]
  changes   HubChangeRequest[]

  @@unique([projectId, number])
  @@index([quoteId])
  @@map("hub_deliveries")
}

/// A message between the client and the platform (the lead and staff) about a project.
/// Students never see these: the lead passes on what the team needs.
model HubComment {
  id         String   @id @default(uuid(7)) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  deliveryId String?  @map("delivery_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  project  HubProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  delivery HubDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  author   User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("hub_comments")
}

enum HubChangeStatus {
  OPEN
  /// Inside the statement of work: the lead adds tasks to the quote.
  IN_SCOPE
  /// Beyond it: a change quote follows.
  QUOTED
  DECLINED
}

/// A change the client asks for: in scope (new tasks), quoted separately, or declined.
model HubChangeRequest {
  id          String          @id @default(uuid(7)) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  deliveryId  String?         @map("delivery_id") @db.Uuid
  body        String
  status      HubChangeStatus @default(OPEN)
  createdById String?         @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  decidedById String?         @map("decided_by_id") @db.Uuid
  decidedAt   DateTime?       @map("decided_at")
  /// The lead's answer to the client.
  note        String?
  /// The change quote made for it.
  quoteId     String?         @map("quote_id") @db.Uuid

  project   HubProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  delivery  HubDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  quote     HubQuote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("HubChangeAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy User?        @relation("HubChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@map("hub_change_requests")
}

/// A student's part of one paid invoice whose work the client accepted: held for the
/// country's hold days (in case the client's payment is reversed), then payable — paid
/// out to their parent. The ledger has the money; this row has the hold.
model HubEarning {
  id          String    @id @default(uuid(7)) @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  invoiceId   String    @map("invoice_id") @db.Uuid
  currency    String    @db.Char(3)
  amountMinor Int       @map("amount_minor")
  heldUntil   DateTime  @map("held_until")
  releasedAt  DateTime? @map("released_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  student User       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  project HubProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  invoice HubInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, studentId])
  @@index([studentId, createdAt])
  @@index([releasedAt, heldUntil])
  @@map("hub_earnings")
}

enum PayoutAccountKind {
  /// A bank account by IBAN: paid through the payouts provider (Wise), or by hand.
  IBAN
  /// Anything else (a mobile wallet, a local account number): paid by hand only.
  OTHER
}

/// Where a parent receives their children's hub earnings. The details are encrypted
/// (ENCRYPTION_KEY); only the last four characters stay readable. A new account can be
/// paid only after the cooling-off time (48 hours) and once staff have checked it.
/// Changing it means a new row (the old one is removed): one live account per parent.
model PayoutAccount {
  id                  String            @id @default(uuid(7)) @db.Uuid
  parentId            String            @map("parent_id") @db.Uuid
  kind                PayoutAccountKind
  /// The account's currency (what the parent's bank receives).
  currency            String            @db.Char(3)
  countryCode         String            @map("country_code") @db.Char(2)
  /// {holderName, iban} or {holderName, details}, encrypted.
  detailsCipher       String            @map("details_cipher")
  last4               String
  usableFrom          DateTime          @map("usable_from")
  verifiedAt          DateTime?         @map("verified_at")
  verifiedById        String?           @map("verified_by_id") @db.Uuid
  /// The payouts provider's recipient for it (a Wise account ID), made on first use.
  providerRecipientId String?           @map("provider_recipient_id")
  removedAt           DateTime?         @map("removed_at")
  createdAt           DateTime          @default(now()) @map("created_at")

  parent     User     @relation("PayoutAccountParent", fields: [parentId], references: [id], onDelete: Restrict)
  verifiedBy User?    @relation("PayoutAccountVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  payouts    Payout[]

  @@index([parentId, createdAt])
  @@map("payout_accounts")
}

enum PayoutProvider {
  /// Sent through Wise (or its mock in development).
  WISE
  /// Paid by staff outside the platform and recorded here.
  MANUAL
}

enum PayoutBatchStatus {
  /// Made; parents confirm, two super admins approve.
  DRAFT
  APPROVED
  /// Sent (Wise), or released for staff to pay and record (manual).
  SENT
  CANCELLED
}

/// A round of payouts in one currency. Two different super admins approve it before
/// any money moves; payouts its parents didn't confirm are left out when it's sent.
model PayoutBatch {
  id                 String            @id @default(uuid(7)) @db.Uuid
  /// "B-0007".
  number             Int               @unique @default(autoincrement())
  currency           String            @db.Char(3)
  provider           PayoutProvider
  status             PayoutBatchStatus @default(DRAFT)
  note               String?
  createdById        String            @map("created_by_id") @db.Uuid
  firstApprovedById  String?           @map("first_approved_by_id") @db.Uuid
  firstApprovedAt    DateTime?         @map("first_approved_at")
  secondApprovedById String?           @map("second_approved_by_id") @db.Uuid
  secondApprovedAt   DateTime?         @map("second_approved_at")
  sentAt             DateTime?         @map("sent_at")
  cancelledAt        DateTime?         @map("cancelled_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  createdBy        User     @relation("PayoutBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  firstApprovedBy  User?    @relation("PayoutBatchFirstApprover", fields: [firstApprovedById], references: [id], onDelete: Restrict)
  secondApprovedBy User?    @relation("PayoutBatchSecondApprover", fields: [secondApprovedById], references: [id], onDelete: Restrict)
  payouts          Payout[]

  @@index([status, createdAt])
  @@map("payout_batches")
}

enum PayoutStatus {
  /// Waiting for the parent to confirm the account and amount.
  AWAITING_PARENT
  /// The parent confirmed.
  CONFIRMED
  /// Being handed to the provider.
  SENDING
  /// The provider has it.
  SENT
  PAID
  /// The provider couldn't pay it: the money is payable again.
  FAILED
  /// Not sent (declined, not confirmed in time, the batch or the account went).
  CANCELLED
}

/// A student's payable earnings paid out to their parent's payout account.
model Payout {
  id                 String       @id @default(uuid(7)) @db.Uuid
  /// "PO-0012".
  number             Int          @unique @default(autoincrement())
  batchId            String       @map("batch_id") @db.Uuid
  studentId          String       @map("student_id") @db.Uuid
  parentId           String       @map("parent_id") @db.Uuid
  accountId          String       @map("account_id") @db.Uuid
  currency           String       @db.Char(3)
  /// Taken from the student's payable money.
  amountMinor        Int          @map("amount_minor")
  /// Withheld for tax where the country asks for it.
  withheldMinor      Int          @default(0) @map("withheld_minor")
  /// What the parent receives (before the provider's own fee).
  netMinor           Int          @map("net_minor")
  status             PayoutStatus @default(AWAITING_PARENT)
  parentConfirmedAt  DateTime?    @map("parent_confirmed_at")
  providerTransferId String?      @unique @map("provider_transfer_id")
  providerStatus     String?      @map("provider_status")
  failureReason      String?      @map("failure_reason")
  /// Manual payouts: how they were paid, and the reference.
  method             String?
  reference          String?
  recordedById       String?      @map("recorded_by_id") @db.Uuid
  sentAt             DateTime?    @map("sent_at")
  paidAt             DateTime?    @map("paid_at")
  failedAt           DateTime?    @map("failed_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  batch      PayoutBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  student    User          @relation("PayoutStudent", fields: [studentId], references: [id], onDelete: Restrict)
  parent     User          @relation("PayoutParent", fields: [parentId], references: [id], onDelete: Restrict)
  account    PayoutAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  recordedBy User?         @relation("PayoutRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([studentId, createdAt])
  @@index([parentId, createdAt])
  @@index([status])
  @@map("payouts")
}

enum HubStoryStatus {
  /// Staff wrote it; the parent hasn't answered.
  AWAITING_PARENT
  /// The parent agreed: staff can publish it.
  APPROVED
  /// On the marketing site.
  PUBLISHED
  /// The parent said no or took it back: never shown again.
  WITHDRAWN
}

/// A short story about a student's hub work for the marketing site: their first name
/// only, never a photo, surname, school or city — and only with a parent's agreement,
/// which the parent can take back at any time (it comes off the site at once).
model HubStory {
  id               String         @id @default(uuid(7)) @db.Uuid
  studentId        String         @map("student_id") @db.Uuid
  parentId         String         @map("parent_id") @db.Uuid
  projectId        String?        @map("project_id") @db.Uuid
  languageCode     String         @map("language_code")
  firstName        String         @map("first_name")
  headline         String
  body             String
  status           HubStoryStatus @default(AWAITING_PARENT)
  parentAnsweredAt DateTime?      @map("parent_answered_at")
  publishedAt      DateTime?      @map("published_at")
  withdrawnAt      DateTime?      @map("withdrawn_at")
  createdById      String?        @map("created_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  student   User        @relation("HubStoryStudent", fields: [studentId], references: [id], onDelete: Cascade)
  parent    User        @relation("HubStoryParent", fields: [parentId], references: [id], onDelete: Cascade)
  project   HubProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?       @relation("HubStoryAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, languageCode, publishedAt])
  @@index([parentId, createdAt])
  @@map("hub_stories")
}
