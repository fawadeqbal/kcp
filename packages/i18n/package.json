{
  "name": "@kcp/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Interface text in every launch language, shared by the web apps (and later the Flutter app). Keep keys identical across languages.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/*.json": "./messages/*.json"
  },
  "files": [
    "dist",
    "messages"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  }
}
