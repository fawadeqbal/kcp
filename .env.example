# Copy this file to .env and adjust if needed:  cp .env.example .env
# Values below match docker-compose.yml, so local development works as-is.

# NODE_ENV is not set here on purpose: the API defaults to development, and a
# NODE_ENV in this file would leak into production builds of the web apps.
LOG_LEVEL=debug

# API
API_PORT=3000
# Comma-separated list of web origins allowed to call the API
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# PostgreSQL (docker compose service "postgres")
DATABASE_URL=postgresql://kcp:kcp@localhost:5432/kcp

# Redis (docker compose service "redis")
REDIS_URL=redis://localhost:6379

# Auth — development-only values. Every other environment needs its own secrets:
#   JWT_ACCESS_SECRET: openssl rand -base64 48
#   ENCRYPTION_KEY:    openssl rand -base64 32
JWT_ACCESS_SECRET=dev-only-access-token-secret-change-me-0123456789
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# Email in development is caught by Mailpit: open http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Kids Coding Platform <no-reply@localhost>

# Where the student and parent web app runs (used in email links)
WEB_APP_URL=http://localhost:3001

# Where the marketing site runs (the waitlist confirmation link in emails)
SITE_URL=http://localhost:3003

# File storage (S3 API). Locally the API uses the storage container from
# docker-compose ("pnpm services:up") with its built-in development credentials,
# so nothing needs setting here. Staging and production use Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=kcp-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Payments. Without a Stripe key, development uses a mock of Stripe Checkout (with
# signed webhooks, so the whole flow works); production then has no card payments
# until the keys are set (manual payments recorded by staff still work).
# To use Stripe (test mode first): the secret key, and the signing secret of a
# webhook endpoint pointing at <API>/v1/payments/webhooks/stripe:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# The API as browsers reach it (the mock's checkout page lives there):
API_PUBLIC_URL=http://localhost:3000

# Push notifications for the mobile app (streak reminders, trial ending, monthly
# summary). Without a Firebase service account they are only written to the API log.
# Firebase console → Project settings → Service accounts → Generate new private key,
# then paste the JSON on one line or base64-encode it (base64 -w0 key.json):
# FIREBASE_SERVICE_ACCOUNT=
